// SPDX-License-Identifier: GPL-2.0
/*
 * NVIDIA SHIELD TV 2017 ("darcy", board P2894-0050-a08) as our boot chain
 * starts it: mainline's board description plus what Linux needs from us.
 * U-Boot adds the rest: the memory map cboot reports and a
 * simple-framebuffer for the HDMI console.
 */
/dts-v1/;

#include "nvidia/tegra210-p2894-0050-a08.dts"
#include <dt-bindings/thermal/thermal.h>

/ {
	chosen {
		/*
		 * The last console is /dev/console, the TV. Nothing drives the
		 * display yet, so its clocks, power domains and supplies must
		 * stay as cboot left them; unclaimed supplies would otherwise
		 * be switched off 30 seconds after boot. CPU idle is off for
		 * the first boots, although the secure monitor implements the
		 * C7 state (stock Android uses it).
		 *
		 * A panic resets the board after 10 s, back into the recovery
		 * slot where U-Boot shows the log; darcy-init writes its
		 * report into the log too (printk.devkmsg=on: unthrottled).
		 */
		bootargs = "earlycon=uart8250,mmio32,0x70006000 console=ttyS0,115200n8 console=tty0 fbcon=font:TER16x32 consoleblank=0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused cpuidle.off=1 ignore_loglevel panic=10 printk.devkmsg=on";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Stock's ramoops carveout, so warm reboots preserve it */
		ramoops@b0000000 {
			compatible = "ramoops";
			reg = <0x0 0xb0000000 0x0 0x200000>;
			record-size = <0x20000>;
			console-size = <0x100000>;
			pmsg-size = <0x40000>;
			no-map;
		};

		/*
		 * The EMC table, which U-Boot fills at each boot from the one
		 * cboot trains (patches/u-boot): room for the 16 rates
		 * tegra210-emc reads. Left zeroed, it keeps the EMC at the
		 * rate cboot left.
		 */
		emc_table: emc-table@b0200000 {
			compatible = "nvidia,tegra210-emc-table";
			reg = <0x0 0xb0200000 0x0 0x14000>;
			no-map;
		};
	};
};

&emc {
	memory-region = <&emc_table>;
	memory-region-names = "nominal";
};

/*
 * regulator-fixed drives a rail's enable pin low at probe unless the rail
 * is boot-on, so these always-on rails would be pulsed off. vdd-sys-boost
 * feeds HDMI 5V.
 */
&vdd_3v3 {
	regulator-boot-on;
};

&vdd_sys_boost {
	regulator-boot-on;
};

&vdd_disp_3v0 {
	regulator-boot-on;
};

/*
 * Where mainline's PMIC setup differs from the stock darcy device tree, the
 * stock values are kept; HDMI depends on both:
 *  - sd2 feeds the 1.05 V LDOs of the HDMI PHY and display PLLs (ldo7,
 *    ldo8). Mainline fixes it at 3.0 V, which the regulator core applies at
 *    probe. Stock allows 1.35-3.0 V, so Linux keeps cboot's voltage; the
 *    other Tegra X1 boards (p2180, p3450, smaug) run it at 1.35 V.
 *  - PMIC GPIO1 enables the 5V boost behind HDMI 5V. Stock keeps it off
 *    the power sequencer.
 */
&max77620_sd2 {
	regulator-min-microvolt = <1350000>;
};

&max77620_default {
	gpio1 {
		maxim,active-fps-source = <MAX77620_FPS_SRC_NONE>;
	};
};

/*
 * The HDMI 5V switch (GPIO CC7), SOR1's hdmi-supply. Boot-on, so its probe
 * keeps the pin high (regulator/fixed.c), and always on, so that SOR1
 * giving it up (a failed probe, the module unloading) doesn't cut the TV's
 * 5V: the TV signals hot-plug from that 5V.
 */
&vdd_hdmi {
	regulator-always-on;
};

/*
 * The PMC driver powers down every power partition it finds on, so that a
 * driver later powers it up from a known state (tegra_powergate_add() in
 * drivers/soc/tegra/pmc.c; pd_ignore_unused does not cover this). For the
 * SOR partition that cuts the HDMI encoder cboot left running, and the TV
 * loses the signal. Until tegra-drm drives HDMI itself, the partition is
 * kept away from the PMC driver: no power-domains references, no node.
 */
&dpaux1 {
	/delete-property/ power-domains;
};

&{/host1x@50000000/vi@54080000/csi@838} {
	/delete-property/ power-domains;
};

&dsia {
	/delete-property/ power-domains;
};

&dsib {
	/delete-property/ power-domains;
};

&sor0 {
	/delete-property/ power-domains;
};

&sor1 {
	/delete-property/ power-domains;
};

&dpaux {
	/delete-property/ power-domains;
};

&{/hda@70030000} {
	/delete-property/ power-domains;
};

&mipi {
	/delete-property/ power-domains;
};

/delete-node/ &pd_sor;

/*
 * HDMI through tegra-drm: SOR1, as on Jetson TX1 and Nano
 * (tegra210-p2597.dtsi, tegra210-p3450-0000.dts) and as the stock darcy
 * device tree wires it (tegra210-ers-hdmi-e2190-1100-a00.dtsi):
 *  - DDC on I2C4, through DPAUX1's pads, so DPAUX1 is on for their pinmux
 *  - hot-plug on GPIO CC1, low while a TV is connected
 *  - the supplies NVIDIA's darcy power tree names: ldo8 for the PHY, sd3
 *    for the PLL, vdd_hdmi for the connector's 5V
 * The lane crossbar cboot programs (SOR_XBAR_CTRL 0x8d111828) is mainline's
 * Tegra210 default, so there is no nvidia,xbar-cfg. SOR1, DPAUX1 and the
 * display controllers are drivers in the tegra-drm module: until it loads,
 * only vdd_hdmi probes (keeping CC7 high), and I2C4 waits for DPAUX1's
 * pinmux. Loading it resets the display at once (the DC and SOR probes),
 * and the TV stays dark until tegra-drm has set a mode.
 */
&dpaux1 {
	status = "okay";
};

&sor1 {
	avdd-io-hdmi-dp-supply = <&max77620_ldo8>;
	vdd-hdmi-dp-pll-supply = <&max77620_sd3>;
	hdmi-supply = <&vdd_hdmi>;
	nvidia,ddc-i2c-bus = <&hdmi_ddc>;
	nvidia,hpd-gpio = <&gpio TEGRA_GPIO(CC, 1) GPIO_ACTIVE_LOW>;
	status = "okay";
};

/ {
	hdmi_ddc: i2c@7000c700 {
		clock-frequency = <100000>;
		status = "okay";
	};
};

/*
 * The GPU (GM20B) for nouveau. Its rail is the stock darcy one (gpu_ovr_reg,
 * tegra210-ers-power-dvfs-e2174-1101-a00.dtsi): an open-loop regulator set
 * by PWM channel 1 and switched by PMIC GPIO 6, with the range, period and
 * delays of Jetson TX1's vdd_gpu (tegra210-p2180.dtsi). cboot leaves the GPU
 * off: GPIO 6 an input, channel 1 disabled, the clamps on. With channel 1
 * disabled the rail starts at its 710 mV floor when nouveau enables it, as
 * on Jetson TX1.
 *
 * cboot also leaves the PWM pins on other functions: lcd_gpio2_pv4 on
 * DISPLAYB, and the fan's pe7 (below) on RSVD0. Android's kernel muxes them
 * to pwm1 and pwm3 with the rest of its pinmux. Here the PWM controller
 * applies just those two pins, as its default state: without it the duty
 * cycle would never reach the regulator or the fan.
 *
 * The controller also runs channel 0 for cboot, the lightbar LED, which
 * nothing in Linux claims: the driver gates the controller's clock while no
 * Linux user has a channel on (tegra_pwm_runtime_suspend()), so the LED can
 * freeze while neither the GPU nor the fan runs.
 */
&pinmux {
	pwm_default: pinmux-pwm {
		lcd_gpio2_pv4 {
			nvidia,pins = "lcd_gpio2_pv4";
			nvidia,function = "pwm1";
			nvidia,pull = <TEGRA_PIN_PULL_NONE>;
			nvidia,tristate = <TEGRA_PIN_DISABLE>;
			nvidia,enable-input = <TEGRA_PIN_DISABLE>;
			nvidia,open-drain = <TEGRA_PIN_DISABLE>;
		};

		pe7 {
			nvidia,pins = "pe7";
			nvidia,function = "pwm3";
			nvidia,pull = <TEGRA_PIN_PULL_NONE>;
			nvidia,tristate = <TEGRA_PIN_DISABLE>;
			nvidia,enable-input = <TEGRA_PIN_DISABLE>;
		};
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_default>;
	status = "okay";
};

/*
 * The fan, which nothing ran before: the stock darcy device tree's pwm-fan
 * (tegra210-darcy-pwm-fan.dtsi), on PWM channel 3 (pin pe7) at a 65536 ns
 * period, its 5V switched by vdd_fan (GPIO E4), its tachometer on GPIO G0.
 * The fan's PWM input is inverted, measured with the pin driven as a GPIO:
 * low ran it flat out (1103 tachometer edges in 3 s, +0.63 W), high stopped
 * it. Linux's Tegra PWM has no inverted polarity, so the levels count down:
 * duty 255 stops the fan; the others are stock's "cool" profile (25, 43, 51,
 * 62.5 and 94 percent), then full. The top level is 1, not 0: pwm-fan turns
 * the PWM off for 0, and an off Tegra PWM drives its pin low.
 *
 * The driver starts the fan at its top level, until the trips below take
 * over.
 */
/ {
	fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm 3 65536>;
		fan-supply = <&vdd_fan>;
		cooling-levels = <255 190 145 125 96 16 1>;
		#cooling-cells = <2>;
		interrupts-extended = <&gpio TEGRA_GPIO(G, 0) IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2>;
	};
};

/*
 * The fan follows the CPU's temperature: stock darcy's "cool" profile starts
 * it at 50 C. These start it at 45 C, and add two more steps up to 95 C.
 */
&{/thermal-zones/cpu-thermal} {
	trips {
		fan1: fan-45 {
			temperature = <45000>;
			hysteresis = <3000>;
			type = "active";
		};

		fan2: fan-55 {
			temperature = <55000>;
			hysteresis = <3000>;
			type = "active";
		};

		fan3: fan-65 {
			temperature = <65000>;
			hysteresis = <3000>;
			type = "active";
		};

		fan4: fan-75 {
			temperature = <75000>;
			hysteresis = <3000>;
			type = "active";
		};

		fan5: fan-85 {
			temperature = <85000>;
			hysteresis = <3000>;
			type = "active";
		};

		fan6: fan-95 {
			temperature = <95000>;
			hysteresis = <3000>;
			type = "active";
		};
	};

	cooling-maps {
		fan-45 {
			trip = <&fan1>;
			cooling-device = <&fan 1 1>;
		};

		fan-55 {
			trip = <&fan2>;
			cooling-device = <&fan 2 2>;
		};

		fan-65 {
			trip = <&fan3>;
			cooling-device = <&fan 3 3>;
		};

		fan-75 {
			trip = <&fan4>;
			cooling-device = <&fan 4 4>;
		};

		fan-85 {
			trip = <&fan5>;
			cooling-device = <&fan 5 5>;
		};

		fan-95 {
			trip = <&fan6>;
			cooling-device = <&fan 6 6>;
		};
	};
};

/*
 * Passive cooling: from 82 C on the CPU sensor or 85 C on the memory
 * sensor, the thermal core lowers the CPUs' highest rate a step at a time
 * (cpufreq cooling), while the fan runs at its top levels. The four cores
 * share one cpufreq policy, which registers a single cooling device for
 * cpu@0. The memory zone polls once a second while above a passive trip,
 * as the CPU zone does; its own passive trip at 50 C maps only to the EMC,
 * which has no driver here yet. The soctherm hardware throttle (98.5 C)
 * and the thermal guard (rootfs/) stay in place behind this.
 */
&{/cpus/cpu@0} {
	#cooling-cells = <2>;
};

&{/thermal-zones/cpu-thermal} {
	trips {
		cpu_passive: cpu-passive {
			temperature = <82000>;
			hysteresis = <2000>;
			type = "passive";
		};
	};

	cooling-maps {
		cpu-passive {
			trip = <&cpu_passive>;
			cooling-device = <&{/cpus/cpu@0} THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

&{/thermal-zones/mem-thermal} {
	polling-delay-passive = <1000>;

	trips {
		mem_passive: mem-passive-cpu {
			temperature = <85000>;
			hysteresis = <2000>;
			type = "passive";
		};
	};

	cooling-maps {
		mem-passive-cpu {
			trip = <&mem_passive>;
			cooling-device = <&{/cpus/cpu@0} THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

/*
 * The CPU's clock and voltage: the DFLL, in PWM mode as on stock darcy
 * (tegra210-p2530-common.dtsi) and Jetson Nano (tegra210-p3450-0000.dts),
 * with the same values. Its PWM output (pin dvfs_pwm_pbb1, which cboot
 * leaves on CLDVFS, tristated) sets the CPU rail from 708 mV in 19.2 mV
 * steps; tristated, the rail sits at 1.0 V. cpufreq switches the CPU from
 * pll_x to the DFLL, which then picks the voltage for each rate itself
 * (closed loop). Until then, the CPU runs on pll_x at 1017.6 MHz.
 *
 * The DFLL's rates stop at 1020 MHz while it is brought up
 * (patches/linux/0003). The pin states are complete, since the pinmux's
 * own state (mainline's "boot") is never applied.
 */
&dfll {
	nvidia,cf = <6>;
	nvidia,ci = <0>;
	nvidia,cg = <2>;
	nvidia,droop-ctrl = <0x00000f00>;
	nvidia,force-mode = <1>;
	nvidia,sample-rate = <25000>;

	nvidia,pwm-min-microvolts = <708000>;
	nvidia,pwm-period-nanoseconds = <2500>;
	nvidia,pwm-to-pmic;
	nvidia,pwm-tristate-microvolts = <1000000>;
	nvidia,pwm-voltage-step-microvolts = <19200>;

	pinctrl-names = "dvfs_pwm_enable", "dvfs_pwm_disable";
	pinctrl-0 = <&dvfs_pwm_active_state>;
	pinctrl-1 = <&dvfs_pwm_inactive_state>;
	status = "okay";
};

&pinmux {
	dvfs_pwm_active_state: pinmux-dvfs-pwm-active {
		dvfs_pwm_pbb1 {
			nvidia,pins = "dvfs_pwm_pbb1";
			nvidia,function = "cldvfs";
			nvidia,pull = <TEGRA_PIN_PULL_NONE>;
			nvidia,tristate = <TEGRA_PIN_DISABLE>;
			nvidia,enable-input = <TEGRA_PIN_DISABLE>;
			nvidia,open-drain = <TEGRA_PIN_DISABLE>;
		};
	};

	dvfs_pwm_inactive_state: pinmux-dvfs-pwm-inactive {
		dvfs_pwm_pbb1 {
			nvidia,pins = "dvfs_pwm_pbb1";
			nvidia,function = "cldvfs";
			nvidia,pull = <TEGRA_PIN_PULL_NONE>;
			nvidia,tristate = <TEGRA_PIN_ENABLE>;
			nvidia,enable-input = <TEGRA_PIN_DISABLE>;
			nvidia,open-drain = <TEGRA_PIN_DISABLE>;
		};
	};
};

/ {
	vdd_gpu: regulator-vdd-gpu {
		compatible = "pwm-regulator";
		pwms = <&pwm 1 8000>;
		regulator-name = "vdd-gpu";
		regulator-min-microvolt = <710000>;
		regulator-max-microvolt = <1320000>;
		enable-gpios = <&pmic 6 GPIO_ACTIVE_HIGH>;
		regulator-ramp-delay = <80>;
		regulator-enable-ramp-delay = <2000>;
		regulator-settling-time-us = <160>;
	};
};

/*
 * The GPU's clocks are the SoC file's plus the fuse clock. nouveau keeps it
 * on while the GPU is powered (patches/linux/0001): with it gated, the
 * GPU's first register read stalls the bus (NOTES.md). The same is posted
 * upstream for every Tegra210 board.
 */
&{/gpu@57000000} {
	clocks = <&tegra_car TEGRA210_CLK_GPU>,
		 <&tegra_car TEGRA210_CLK_PLL_P_OUT5>,
		 <&tegra_car TEGRA210_CLK_PLL_G_REF>,
		 <&tegra_car TEGRA210_CLK_FUSE>;
	clock-names = "gpu", "pwr", "ref", "fuse";
	vdd-supply = <&vdd_gpu>;
	status = "okay";
};

/*
 * The power monitor, as the stock darcy device tree has it
 * (tegra210-darcy-p2894-common.dtsi): an INA3221 on I2C2, its three inputs
 * behind 5 mOhm shunts. cboot leaves the bus's pins on I2C2. VDD_SYS is the
 * system input, which shows whether a rail (the GPU's, say) really draws.
 */
&{/i2c@7000c400} {
	status = "okay";

	power-sensor@40 {
		compatible = "ti,ina3221";
		reg = <0x40>;
		#address-cells = <1>;
		#size-cells = <0>;

		input@0 {
			reg = <0x0>;
			label = "VDD_NOOP";
			shunt-resistor-micro-ohms = <5000>;
		};

		input@1 {
			reg = <0x1>;
			label = "VDD_IO";
			shunt-resistor-micro-ohms = <5000>;
		};

		input@2 {
			reg = <0x2>;
			label = "VDD_SYS";
			shunt-resistor-micro-ohms = <5000>;
		};
	};
};

/*
 * USB: the port near HDMI as a host, wired as in the stock darcy device tree
 * (USB 2 lane 2, with UPHY lane pcie-5 for SuperSpeed as usb3-1), with the
 * supplies NVIDIA's darcy power tree names
 * (tegra210-darcy-power-tree-p2894-0000-a00.dtsi). The port far from HDMI
 * (usb2-0/usb3-0, OTG) carries the fastboot link to the laptop, which powers
 * that cable, so Linux leaves it alone for now.
 */
&padctl {
	avdd-pll-utmip-supply = <&max77620_sd3>;
	avdd-pll-uerefe-supply = <&max77620_ldo7>;
	dvdd-pex-pll-supply = <&max77620_ldo1>;
	hvdd-pex-pll-e-supply = <&max77620_sd3>;
	status = "okay";

	pads {
		usb2 {
			status = "okay";

			lanes {
				usb2-2 {
					nvidia,function = "xusb";
					status = "okay";
				};
			};
		};

		pcie {
			status = "okay";

			lanes {
				pcie-5 {
					nvidia,function = "usb3-ss";
					status = "okay";
				};
			};
		};
	};

	ports {
		usb2-2 {
			mode = "host";
			vbus-supply = <&usb_vbus2>;
			status = "okay";
		};

		usb3-1 {
			nvidia,usb2-companion = <2>;
			status = "okay";
		};
	};
};

&{/usb@70090000} {
	phys = <&{/padctl@7009f000/pads/usb2/lanes/usb2-2}>,
	       <&{/padctl@7009f000/pads/pcie/lanes/pcie-5}>;
	phy-names = "usb2-2", "usb3-1";
	dvddio-pex-supply = <&max77620_ldo1>;
	hvddio-pex-supply = <&max77620_sd3>;
	avdd-usb-supply = <&vdd_3v3>;
	status = "okay";
};

/*
 * Wi-Fi: the BCM4354 on SDMMC2, as in the stock darcy device tree
 * (bcmdhd_wlan: power on GPIO H0, host wake on H2) and like the same chip
 * on the Pixel C (tegra210-smaug.dts). Its firmware, darcy's NVRAM and CLM
 * blob come from NVIDIA's vendor partition (config.sh VENDOR_FIRMWARE).
 */
&{/mmc@700b0200} {
	power-gpios = <&gpio TEGRA_GPIO(H, 0) GPIO_ACTIVE_HIGH>;
	bus-width = <4>;
	non-removable;
	vqmmc-supply = <&max77620_sd3>;
	vmmc-supply = <&vdd_3v3>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm4354-fmac", "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&gpio>;
		interrupts = <TEGRA_GPIO(H, 2) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";

		/*
		 * The firmware's locale for each country: NVIDIA's table for
		 * darcy, which ships with the same CLM blob (country_code_map
		 * in the downstream darcy device tree; its "E0" entry is not a
		 * country and is left out). brcmfmac passes cfg80211's country
		 * (cfg80211.ieee80211_regdom, config.sh WIFI_COUNTRY) on to a
		 * BCM4354 only through such a map; without it the firmware
		 * keeps the NVRAM's ccode=XV, which can leave out every 5 GHz
		 * channel.
		 */
		brcm,ccode-map = "XV-XV-0", "US-US-0", "CA-Q2-0", "AT-DE-0", "BE-DE-0", "BG-DE-0",
				 "HR-DE-0", "CY-DE-0", "CZ-DE-0", "DK-DE-0", "EE-DE-0", "FI-DE-0",
				 "FR-DE-0", "DE-DE-0", "GR-DE-0", "HU-DE-0", "IS-DE-0", "IE-DE-0",
				 "IT-DE-0", "LV-DE-0", "LI-DE-0", "LT-DE-0", "LU-DE-0", "MT-DE-0",
				 "NL-DE-0", "NO-DE-0", "PL-DE-0", "PT-DE-0", "RO-DE-0", "SK-DE-0",
				 "SI-DE-0", "ES-DE-0", "SE-DE-0", "CH-DE-0", "TR-DE-0", "GB-DE-0",
				 "EU-DE-0", "AU-AU-0", "CN-CN-0", "IN-IN-0", "JP-JP-0", "KR-KR-0",
				 "RU-RU-0", "TW-US-0", "SG-DE-0", "HK-DE-0", "NZ-AU-0", "AP-XY-0";
	};
};

/*
 * Bluetooth: the BCM4354's Bluetooth core on UARTD, the port Android uses
 * (ttyTHS3, labelled hci_attach_dev in its SELinux contexts), with the GPIOs
 * of the stock bluedroid_pm node (shutdown H4, device wake H3, host wake
 * H5): the same wiring as the Pixel C (tegra210-smaug.dts). Its firmware
 * patch comes from NVIDIA's vendor partition (VENDOR_FIRMWARE).
 *
 * serial-tegra numbers a port by its serialN alias and refuses one without
 * ("failed to get alias id, errno -19"); darcy's board file only names the
 * debug UART, so UARTD gets smaug's alias, 3, which is ttyTHS3 as on Android.
 *
 * hci_bcm talks at 115200 baud until the patch is in, then at max-speed.
 * That is 3 Mbaud, as NVIDIA's Android sets it (libbt-vendor: "set UART
 * baud 3000000") and as UARTD's clock makes it exactly: PLLP's 408 MHz / 8.5
 * = 16 x 3 Mbaud. Smaug's 4 Mbaud would come out 1.9% slow.
 */
/ {
	aliases {
		serial3 = &uartd;
	};
};

&{/serial@70006300} {
	compatible = "nvidia,tegra30-hsuart";
	reset-names = "serial";
	/delete-property/ reg-shift;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm43540-bt";
		max-speed = <3000000>;
		device-wakeup-gpios = <&gpio TEGRA_GPIO(H, 3) GPIO_ACTIVE_HIGH>;
		shutdown-gpios = <&gpio TEGRA_GPIO(H, 4) GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&gpio>;
		interrupts = <TEGRA_GPIO(H, 5) IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wakeup";
	};
};

/*
 * Ethernet: the RTL8168 sits on PCIe. Both root ports as in the stock darcy
 * device tree (x4 on lanes pcie-1..4, x1 on pcie-0); the one whose link
 * comes up shows where the chip is.
 */
&padctl {
	pads {
		pcie {
			lanes {
				pcie-0 {
					nvidia,function = "pcie-x1";
					status = "okay";
				};

				pcie-1 {
					nvidia,function = "pcie-x4";
					status = "okay";
				};

				pcie-2 {
					nvidia,function = "pcie-x4";
					status = "okay";
				};

				pcie-3 {
					nvidia,function = "pcie-x4";
					status = "okay";
				};

				pcie-4 {
					nvidia,function = "pcie-x4";
					status = "okay";
				};
			};
		};
	};
};

&{/pcie@1003000} {
	hvddio-pex-supply = <&max77620_sd3>;
	dvddio-pex-supply = <&max77620_ldo1>;
	vddio-pex-ctl-supply = <&max77620_sd3>;
	status = "okay";

	pci@1,0 {
		phys = <&{/padctl@7009f000/pads/pcie/lanes/pcie-1}>,
		       <&{/padctl@7009f000/pads/pcie/lanes/pcie-2}>,
		       <&{/padctl@7009f000/pads/pcie/lanes/pcie-3}>,
		       <&{/padctl@7009f000/pads/pcie/lanes/pcie-4}>;
		phy-names = "pcie-0", "pcie-1", "pcie-2", "pcie-3";
		status = "okay";
	};

	pci@2,0 {
		phys = <&{/padctl@7009f000/pads/pcie/lanes/pcie-0}>;
		phy-names = "pcie-0";
		status = "okay";
	};
};

/*
 * The timer block also holds the watchdog U-Boot arms (timer 5 driving
 * WDT 0). tegra_wdt knows it only by Tegra30's name, whose registers these
 * are; bound, it lets systemd take the watchdog over. Until something opens
 * /dev/watchdog it leaves U-Boot's watchdog running.
 */
&{/timer@60005000} {
	compatible = "nvidia,tegra210-timer", "nvidia,tegra30-timer";
};

/*
 * The PMC is secure-only on the SHIELD. Linux needs no property for that:
 * on Tegra210 it probes for it and goes through the secure monitor
 * (maybe_tz_only in drivers/soc/tegra/pmc.c).
 */
