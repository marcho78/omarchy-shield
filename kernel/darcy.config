# Merged into arm64's defconfig by scripts/11-build-kernel.sh, after every
# platform but Tegra is switched off. Built in, because the first payloads
# carry no modules.

CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_TEGRA_210_SOC=y

# Console on the HDMI framebuffer U-Boot hands over (simple-framebuffer),
# with a font readable from the couch
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Crash logs that survive a warm reboot: ramoops at 0xb0000000 (kernel/dts)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# The initramfs carries the first userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Networking: Ethernet (RTL8168 on PCIe) and Wi-Fi (BCM4354 on SDIO);
# cfg80211 can only be built in when rfkill is
CONFIG_R8169=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y

# Bluetooth over UART (hci_bcm, for the BCM4354's Bluetooth core)
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y

# The installed system: systemd takes over the watchdog U-Boot arms, through
# tegra_wdt on the timer node (kernel/dts); BlueZ's HID over GATT (Bluetooth
# LE keyboards and remotes) needs uhid
CONFIG_TEGRA_WATCHDOG=y
CONFIG_UHID=y

# Arch's linux-firmware is compressed with zstd (the Ethernet PHY patch is
# loaded from it when eth0 comes up, after the root filesystem is mounted)
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# iwd does its crypto through the kernel (AF_ALG sockets and keyctl) and
# exits at start without these, listing what it misses; MD5 and DES are
# built in so that nothing waits for a module. The PKCS#8 parser is what
# iwd's modules-load.d asks for (EAP-TLS keys).
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_DES=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# pacman 7 downloads in a sandbox that restricts itself with Landlock, and
# without it refuses to download at all ("Landlock is not supported by the
# kernel"). The default CONFIG_LSM list already starts with landlock.
CONFIG_SECURITY_LANDLOCK=y

# Omarchy's memory settings: compressed swap in RAM (zram-generator, zstd,
# the size of RAM) and systemd-oomd, which acts on pressure stall
# information. With 3 GB and a browser, both matter.
CONFIG_PSI=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Omarchy's firewall (ufw) and Docker: Arch's iptables is the nftables
# flavour (xtables-nft-multi), which needs nf_tables and its xtables
# compatibility, and Docker needs NAT, veth, a bridge and overlayfs. Taken
# from Arch Linux ARM's linux-aarch64 config, which runs both.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_EGRESS=y
CONFIG_NETFILTER_SKIP_EGRESS=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_NETFILTER_FAMILY_ARP=y
CONFIG_NETFILTER_BPF_LINK=y
CONFIG_NETFILTER_NETLINK_HOOK=m
CONFIG_NETFILTER_NETLINK_ACCT=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_OSF=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NETFILTER_CONNCOUNT=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CT_PROTO_GRE=y
CONFIG_NF_CT_PROTO_SCTP=y
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_H323=m
