From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: marcho78 <marcho78@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:20:00 -0700
Subject: [PATCH] board: nvidia: p2894: Pass cboot's device tree on to Linux

cboot hands U-Boot a device tree with what it works out at boot, such
as the EMC tables it trains for the board's DRAM, which mainline's
tegra210-emc driver needs before it scales the memory clock above
204 MHz. Linux boots with our device tree instead and can't read cboot's
from memory (STRICT_DEVMEM). Put it, whole, in /chosen/darcy,cboot-fdt,
where Linux shows it under /sys/firmware/devicetree, and give the device
tree 1 MiB of room for it.
---
diff --git a/board/nvidia/p2894/p2894.c b/board/nvidia/p2894/p2894.c
index ffdb6d48..87e55351 100644
--- a/board/nvidia/p2894/p2894.c
+++ b/board/nvidia/p2894/p2894.c
@@ -777,8 +777,29 @@ static int tag_bootargs(void *blob)
 }
 
 /*
- * Tag the kernel command line, and hand the console framebuffer on to the
- * kernel, reserved
+ * cboot's own device tree, whole, as /chosen/darcy,cboot-fdt: Linux shows
+ * it under /sys/firmware/devicetree. It holds what cboot works out at boot
+ * that our device tree can't know, such as the EMC tables it trains.
+ * CONFIG_SYS_FDT_PAD leaves the room.
+ */
+static int pass_cboot_fdt(void *blob)
+{
+	const void *fdt = cboot_fdt();
+	int node;
+
+	if (!fdt)
+		return 0;
+
+	node = fdt_find_or_add_subnode(blob, 0, "chosen");
+	if (node < 0)
+		return node;
+
+	return fdt_setprop(blob, node, "darcy,cboot-fdt", fdt, fdt_totalsize(fdt));
+}
+
+/*
+ * Tag the kernel command line, pass cboot's device tree on, and hand the
+ * console framebuffer on to the kernel, reserved
  */
 int ft_board_setup(void *blob, struct bd_info *bd)
 {
@@ -790,6 +811,9 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 	if (tag_bootargs(blob))
 		printf("warning: could not tag the kernel command line\n");
 
+	if (pass_cboot_fdt(blob))
+		printf("warning: could not pass cboot's device tree on\n");
+
 	if (!fb || !video_is_active())
 		return 0;
 
diff --git a/configs/p2894_defconfig b/configs/p2894_defconfig
index eb89d57f..0ae2a41c 100644
--- a/configs/p2894_defconfig
+++ b/configs/p2894_defconfig
@@ -13,6 +13,7 @@ CONFIG_TARGET_P2894=y
 CONFIG_FIT=y
 CONFIG_OF_BOARD_SETUP=y
 CONFIG_OF_BOARD_FIXUP=y
+CONFIG_SYS_FDT_PAD=0x100000
 CONFIG_BOOTDELAY=3
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_BOOTCOMMAND="run darcy_boot"
