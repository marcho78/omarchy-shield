diff --git a/arch/arm/dts/tegra210-p2894.dts b/arch/arm/dts/tegra210-p2894.dts
new file mode 100644
index 00000000..d7c396a4
--- /dev/null
+++ b/arch/arm/dts/tegra210-p2894.dts
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NVIDIA SHIELD TV 2017 ("darcy", board P2894)
+ *
+ * U-Boot runs as a second stage after NVIDIA's cboot, which has already set
+ * up the board, so this only describes what U-Boot itself uses: the debug
+ * UART and the framebuffer cboot leaves running on HDMI.
+ */
+/dts-v1/;
+
+#include "tegra210.dtsi"
+
+/ {
+	model = "NVIDIA SHIELD TV 2017";
+	compatible = "nvidia,p2894-0050-a08", "nvidia,darcy", "nvidia,tegra210";
+
+	chosen {
+		stdout-path = &uarta;
+	};
+
+	aliases {
+		i2c0 = "/i2c@7000d000";
+	};
+
+	/* Replaced by the memory map cboot hands over */
+	memory {
+		reg = <0x0 0x80000000 0x0 0xc0000000>;
+	};
+
+	/*
+	 * cboot keeps its 1080p boot screen on HDMI. board_fix_fdt() fills
+	 * in the address cboot reports and enables this. It stays disabled
+	 * otherwise: video probe clears the surface, so there is no safe
+	 * default address.
+	 */
+	framebuffer {
+		compatible = "simple-framebuffer";
+		reg = <0x0 0x0 0x0 (1920 * 1080 * 4)>;
+		width = <1920>;
+		height = <1080>;
+		stride = <(1920 * 4)>;
+		format = "a8b8g8r8";
+		status = "disabled";
+	};
+
+	i2c@7000d000 {
+		status = "okay";
+		clock-frequency = <400000>;
+	};
+
+	clocks {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		clk32k_in: clock@0 {
+			compatible = "fixed-clock";
+			reg = <0>;
+			#clock-cells = <0>;
+			clock-frequency = <32768>;
+		};
+	};
+};
+
+&uarta {
+	status = "okay";
+};
