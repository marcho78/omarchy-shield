diff --git a/board/nvidia/p2894/p2894.c b/board/nvidia/p2894/p2894.c
new file mode 100644
index 00000000..1cf42c68
--- /dev/null
+++ b/board/nvidia/p2894/p2894.c
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * NVIDIA SHIELD TV 2017 ("darcy", board P2894)
+ *
+ * NVIDIA's cboot starts U-Boot as the kernel of an Android boot image and
+ * leaves the board fully set up, so nothing here touches the hardware. It
+ * only reads what cboot hands over in its device tree (x0):
+ *
+ *  - the framebuffer cboot keeps running on HDMI, for U-Boot's console
+ *  - the boot image's ramdisk, which carries the FIT image to boot
+ *  - the board revision cboot detected
+ *
+ * and reports it on screen, since retail units have no reachable UART.
+ */
+
+#include <env.h>
+#include <fdt_simplefb.h>
+#include <fdt_support.h>
+#include <init.h>
+#include <stdio.h>
+#include <linux/libfdt.h>
+#include <linux/string.h>
+#include <asm/arch-tegra/cboot.h>
+
+/* Written before relocation, when .bss is not usable yet */
+static u64 fb_base __section(".data");
+static u64 fb_size __section(".data");
+
+static const void *cboot_fdt(void)
+{
+	const void *fdt = (const void *)cboot_boot_x0;
+
+	if (!fdt || fdt_check_header(fdt))
+		return NULL;
+
+	return fdt;
+}
+
+/* cboot writes some integers as one cell and some as two */
+static int fdt_read_u64(const void *fdt, const char *path, const char *name,
+			u64 *val)
+{
+	const fdt32_t *cell;
+	int node, len;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	cell = fdt_getprop(fdt, node, name, &len);
+	if (!cell)
+		return len;
+
+	if (len == sizeof(u32))
+		*val = fdt32_to_cpu(cell[0]);
+	else if (len == sizeof(u64))
+		*val = (u64)fdt32_to_cpu(cell[0]) << 32 | fdt32_to_cpu(cell[1]);
+	else
+		return -FDT_ERR_BADVALUE;
+
+	return 0;
+}
+
+/* The surface entry of fb0_carveout, which cboot fills in at boot */
+static int cboot_framebuffer(const void *fdt, u64 *base, u64 *size)
+{
+	const fdt32_t *reg;
+	int node, len;
+
+	node = fdt_path_offset(fdt, "/reserved-memory/fb0_carveout");
+	if (node < 0)
+		return node;
+
+	reg = fdt_getprop(fdt, node, "reg", &len);
+	if (!reg || len < 4 * sizeof(u32))
+		return -FDT_ERR_BADVALUE;
+
+	*base = (u64)fdt32_to_cpu(reg[0]) << 32 | fdt32_to_cpu(reg[1]);
+	*size = (u64)fdt32_to_cpu(reg[2]) << 32 | fdt32_to_cpu(reg[3]);
+
+	return *base ? 0 : -FDT_ERR_NOTFOUND;
+}
+
+/*
+ * Point U-Boot's simple-framebuffer at cboot's surface before video probes.
+ * Any failure keeps the built-in default; returning an error would hang.
+ */
+int board_fix_fdt(void *blob)
+{
+	const void *fdt = cboot_fdt();
+	const fdt32_t *cur;
+	fdt32_t reg[4];
+	int node, len;
+
+	if (!fdt || cboot_framebuffer(fdt, &fb_base, &fb_size))
+		return 0;
+
+	node = fdt_path_offset(blob, "/framebuffer");
+	if (node < 0)
+		return 0;
+
+	cur = fdt_getprop(blob, node, "reg", &len);
+	if (!cur || len != sizeof(reg))
+		return 0;
+
+	memcpy(reg, cur, sizeof(reg));
+	reg[0] = cpu_to_fdt32(fb_base >> 32);
+	reg[1] = cpu_to_fdt32(fb_base);
+	fdt_setprop_inplace(blob, node, "reg", reg, sizeof(reg));
+
+	return 0;
+}
+
+void nvidia_board_late_init(void)
+{
+	const void *fdt = cboot_fdt();
+	const char *dts, *args;
+	u64 start, end;
+
+	if (!fdt) {
+		printf("cboot: no device tree was handed over\n");
+		return;
+	}
+
+	printf("cboot handoff (device tree at %p):\n", fdt);
+
+	dts = fdt_getprop(fdt, 0, "nvidia,dtsfilename", NULL);
+	printf("  board:       %s\n", dts ? dts : "unknown");
+
+	args = env_get("cbootargs");
+	printf("  bootargs:    %s\n", args ? args : "");
+
+	if (fb_base)
+		printf("  framebuffer: 0x%llx, %llu bytes\n", fb_base, fb_size);
+	else
+		printf("  framebuffer: none reported, using the built-in address\n");
+
+	if (!fdt_read_u64(fdt, "/chosen", "linux,initrd-start", &start) &&
+	    !fdt_read_u64(fdt, "/chosen", "linux,initrd-end", &end) &&
+	    end > start) {
+		printf("  ramdisk:     0x%llx, %llu bytes\n", start, end - start);
+		env_set_hex("cboot_initrd_start", start);
+		env_set_hex("cboot_initrd_size", end - start);
+	} else {
+		printf("  ramdisk:     none\n");
+	}
+}
+
+/* Hand the running console framebuffer on to the kernel */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	if (fdt_simplefb_add_node(blob))
+		printf("warning: no simple-framebuffer for the kernel\n");
+
+	if (fb_base && fdt_add_mem_rsv(blob, fb_base, fb_size))
+		printf("warning: could not reserve the framebuffer\n");
+
+	return 0;
+}
diff --git a/board/nvidia/p2894/p2894.env b/board/nvidia/p2894/p2894.env
new file mode 100644
index 00000000..afe65ed4
--- /dev/null
+++ b/board/nvidia/p2894/p2894.env
@@ -0,0 +1,12 @@
+/*
+ * NVIDIA SHIELD TV 2017 (darcy). cboot loads the Android boot image's
+ * ramdisk, which carries a FIT image (kernel, device tree, initramfs);
+ * p2894.c exports where it landed. The kernel command line comes from the
+ * device tree inside the FIT. CONFIG_BOOTCOMMAND runs darcy_boot.
+ */
+darcy_boot=
+	if test -n "${cboot_initrd_start}"; then
+		echo "Booting the FIT payload at ${cboot_initrd_start}";
+		bootm ${cboot_initrd_start};
+	fi;
+	echo "Nothing to boot: this boot image carries no payload.";
