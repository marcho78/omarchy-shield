diff --git a/board/nvidia/p2894/p2894.c b/board/nvidia/p2894/p2894.c
new file mode 100644
index 00000000..a413fd50
--- /dev/null
+++ b/board/nvidia/p2894/p2894.c
@@ -0,0 +1,813 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * NVIDIA SHIELD TV 2017 ("darcy", board P2894)
+ *
+ * NVIDIA's cboot starts U-Boot as the kernel of an Android boot image and
+ * leaves the board set up, with its boot logo on HDMI. This finds what U-Boot
+ * needs and reports it on screen, since retail units have no reachable UART:
+ *
+ *  - the console framebuffer. It is read from the display controller window
+ *    showing cboot's logo, which is the ground truth; cboot's fb0_carveout
+ *    note in its device tree is the fallback. There is no default address,
+ *    because video probe clears the whole surface.
+ *  - the boot image's ramdisk, from cboot's device tree (x0). It is booted
+ *    only if it lies in RAM and holds a whole FIT image. Its CRC32 is always
+ *    shown, so a test image can check that nothing in U-Boot overwrote it.
+ *  - the board revision and memory map cboot detected.
+ *
+ * With no console on the TV and no FIT to boot, the report would go
+ * nowhere, so the next boot carries the answer instead: back into the
+ * bootloader menu when no framebuffer was found, into Android when one was
+ * found but U-Boot could not use it.
+ *
+ * A kernel that loses the screen would leave nothing to read either, so its
+ * log comes back through the recovery slot. Just before the kernel starts,
+ * any reset is pointed at the recovery slot and the watchdog is armed
+ * (darcy_watchdog seconds). After the reset, U-Boot finds that kernel's
+ * console log in ramoops and shows its end instead of booting again, then
+ * reboots into the bootloader menu (fastboot) after darcy_log_secs, ready
+ * for the next image.
+ *
+ * The installed system, a FIT whose device tree has /chosen/darcy,system,
+ * boots again after a normal reboot: its resets are left to Linux, and its
+ * log is shown only after a panic, which leaves a dump record in ramoops, or
+ * after the watchdog reset the board, which cboot passes on as
+ * androidboot.bootreason=watchdog.
+ */
+
+#include <cpu_func.h>
+#include <env.h>
+#include <fdt_support.h>
+#include <fdtdec.h>
+#include <image.h>
+#include <init.h>
+#include <malloc.h>
+#include <stdio.h>
+#include <sysreset.h>
+#include <video.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/arch-tegra/cboot.h>
+#include <asm/arch-tegra/pmc.h>
+#include <linux/delay.h>
+#include <linux/libfdt.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <u-boot/crc.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* 3 GiB of LPDDR4 */
+#define DRAM_START	0x80000000ULL
+#define DRAM_END	0x140000000ULL
+
+/* Android's reboot reasons in PMC_SCRATCH0, which cboot acts on */
+#define PMC_SCRATCH0_MODE_RECOVERY	BIT(31)
+#define PMC_SCRATCH0_MODE_BOOTLOADER	BIT(30)
+
+/*
+ * Watchdog 0 counting timer 5, set up as Linux's tegra_wdt.c does: the timer
+ * ticks every 250 ms and the watchdog resets the board on its fourth expiry,
+ * so the period field is in seconds. The reset keeps PMC_SCRATCH0 and RAM.
+ */
+#define TMR5_PTV			0x60005060UL
+#define  TMR_EN				BIT(31)
+#define  TMR_PERIODIC			BIT(30)
+#define WDT0_CFG			0x60005100UL
+#define  WDT_CFG_TIMER5			5
+#define  WDT_CFG_PERIOD_SHIFT		4
+#define  WDT_CFG_PMC2CAR_RST_EN		BIT(15)
+#define WDT0_CMD			0x60005108UL
+#define  WDT_CMD_START_COUNTER		BIT(0)
+
+/* A persistent RAM zone's header, as Linux writes it (fs/pstore/ram_core.c) */
+struct ramoops_zone {
+	u32 sig;
+	u32 start;		/* where the next byte goes */
+	u32 size;		/* bytes held, up to the zone's buffer size */
+	u8 data[];
+};
+
+#define RAMOOPS_SIG	0x43474244	/* "DBGC", every zone's */
+
+/* Where ramoops keeps a kernel's dump records and console (ramoops_layout()) */
+struct ramoops {
+	u64 dumps;		/* the first dump record */
+	u64 records;
+	u64 record_size;	/* each, header included */
+	struct ramoops_zone *console;
+	u32 console_size;	/* its buffer */
+};
+
+/* Whether the FIT holds the installed system (/chosen/darcy,system) */
+static bool system_payload;
+
+/* Added to the kernel command line, to tell its log from Android's */
+#define LOG_TAG		"darcy.chain=u-boot"
+#define LOG_LINES	56
+
+/* Display controller A drives HDMI (SOR1) on darcy */
+#define CAR_BASE			0x60006000UL
+#define CAR_RST_DEVICES_L		0x60006004UL
+#define CAR_CLK_OUT_ENB_L		0x60006010UL
+#define  CAR_L_DISP1			BIT(27)
+#define CAR_PLLD_BASE			0x0d0
+#define CAR_PLLD2_BASE			0x4b8
+#define CAR_PLLD2_MISC0			0x4bc
+#define CAR_PLLDP_BASE			0x590
+#define CAR_CLK_SOURCE_DISP1		0x138
+#define CAR_CLK_SOURCE_SOR1		0x410
+#define DC_BASE				0x54200000UL
+#define PMC_PWRGATE_STATUS		0x038
+/* The HDMI pins' pinmux words; bit 5 parks the pin */
+#define PINMUX_HDMI_CEC			0x70003198UL
+#define PINMUX_HDMI_HPD			0x7000319cUL
+
+/* CAR clock-enable and reset registers of the clock banks L, H, U, V, W, X, Y */
+static const u16 car_enb[] = { 0x010, 0x014, 0x018, 0x360, 0x364, 0x280, 0x298 };
+static const u16 car_rst[] = { 0x004, 0x008, 0x00c, 0x358, 0x35c, 0x28c, 0x2a4 };
+
+/* The display blocks, by CAR clock ID (Linux's dt-bindings tegra210-car.h) */
+static const struct {
+	const char *name;
+	u16 id;
+} display_clocks[] = {
+	{ "DISP1", 27 }, { "DISP2", 26 }, { "HOST1X", 28 }, { "DSIA", 48 },
+	{ "MIPI_CAL", 56 }, { "DPAUX", 181 }, { "SOR0", 182 }, { "SOR1", 183 },
+	{ "DPAUX1", 207 }, { "SOR_SAFE", 222 },
+};
+
+/* Register word offsets, from Linux's drivers/gpu/drm/tegra/dc.h */
+#define DC_CMD_DISPLAY_COMMAND		0x032
+#define DC_CMD_DISPLAY_POWER_CONTROL	0x036
+#define DC_CMD_STATE_CONTROL		0x041
+#define DC_CMD_DISPLAY_WINDOW_HEADER	0x042
+#define  WINDOW_A_SELECT		BIT(4)
+#define DC_DISP_DISP_CLOCK_CONTROL	0x42e
+#define DC_WIN_WIN_OPTIONS		0x700
+#define  WIN_ENABLE			BIT(30)
+#define DC_WIN_COLOR_DEPTH		0x703
+#define DC_WIN_PRESCALED_SIZE		0x706
+#define DC_WIN_LINE_STRIDE		0x70a
+#define DC_WINBUF_START_ADDR		0x800
+
+struct fb_mode {
+	u64 base;
+	u64 size;		/* of the buffer; cboot's whole carveout */
+	u32 width, height, stride, bpp;
+	char format[9];		/* simple-framebuffer name, NUL padded */
+	char source;		/* 'A'..'C': controller window, 'c': cboot */
+};
+
+/* Found before relocation, when .bss is not usable yet */
+static struct fb_mode dc_fb __section(".data");
+static struct fb_mode cboot_fb __section(".data");
+/* Which one is in use, by source: a pointer set now would go stale on relocation */
+static char fb_source __section(".data");
+
+static struct fb_mode *fb_in_use(void)
+{
+	if (fb_source && fb_source == dc_fb.source)
+		return &dc_fb;
+	if (fb_source && fb_source == cboot_fb.source)
+		return &cboot_fb;
+	return NULL;
+}
+
+static const void *cboot_fdt(void)
+{
+	const void *fdt = (const void *)cboot_boot_x0;
+
+	if (!fdt || fdt_check_header(fdt))
+		return NULL;
+
+	return fdt;
+}
+
+/* cboot writes some integers as one cell and some as two */
+static int fdt_read_u64(const void *fdt, const char *path, const char *name,
+			u64 *val)
+{
+	const fdt32_t *cell;
+	int node, len;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	cell = fdt_getprop(fdt, node, name, &len);
+	if (!cell)
+		return len;
+
+	if (len == sizeof(u32))
+		*val = fdt32_to_cpu(cell[0]);
+	else if (len == sizeof(u64))
+		*val = (u64)fdt32_to_cpu(cell[0]) << 32 | fdt32_to_cpu(cell[1]);
+	else
+		return -FDT_ERR_BADVALUE;
+
+	return 0;
+}
+
+static void set_format(struct fb_mode *mode, const char *format, u32 bpp)
+{
+	memset(mode->format, 0, sizeof(mode->format));
+	strncpy(mode->format, format, sizeof(mode->format) - 1);
+	mode->bpp = bpp;
+}
+
+static u32 dc_readl(unsigned int reg)
+{
+	return readl(DC_BASE + reg * 4);
+}
+
+static void dc_writel(u32 value, unsigned int reg)
+{
+	writel(value, DC_BASE + reg * 4);
+}
+
+/*
+ * simple-framebuffer names for the window colour depths, as Linux maps them
+ * (tegra_plane_format); 35, 36, 65 and 66 are best guesses, where a wrong
+ * guess only swaps red and blue.
+ */
+static bool dc_format(struct fb_mode *mode, u32 depth)
+{
+	switch (depth) {
+	case 12:	/* B8G8R8A8 */
+	case 35:	/* A8R8G8B8 */
+		set_format(mode, "a8r8g8b8", 4);
+		return true;
+	case 13:	/* R8G8B8A8 */
+	case 36:	/* A8B8G8R8 */
+		set_format(mode, "a8b8g8r8", 4);
+		return true;
+	case 37:	/* B8G8R8X8 */
+	case 66:	/* X8R8G8B8 */
+		set_format(mode, "x8r8g8b8", 4);
+		return true;
+	case 38:	/* R8G8B8X8 */
+	case 65:	/* X8B8G8R8 */
+		set_format(mode, "x8b8g8r8", 4);
+		return true;
+	case 6:		/* B5G6R5 */
+	case 34:	/* R5G6B5 */
+		set_format(mode, "r5g6b5", 2);
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * The first enabled window of display controller A, which shows cboot's logo.
+ * The controller is only touched while it is clocked and out of reset; the
+ * window selector is put back afterwards. Only the low 32 bits of the
+ * address are used: cboot's buffer sits below 4 GiB.
+ */
+static bool dc_framebuffer(struct fb_mode *mode)
+{
+	u32 header, size;
+	bool found = false;
+	int win;
+
+	if (!(readl(CAR_CLK_OUT_ENB_L) & CAR_L_DISP1) ||
+	    readl(CAR_RST_DEVICES_L) & CAR_L_DISP1)
+		return false;
+
+	header = dc_readl(DC_CMD_DISPLAY_WINDOW_HEADER);
+	for (win = 0; win < 3 && !found; win++) {
+		dc_writel(WINDOW_A_SELECT << win, DC_CMD_DISPLAY_WINDOW_HEADER);
+		if (!(dc_readl(DC_WIN_WIN_OPTIONS) & WIN_ENABLE) ||
+		    !dc_format(mode, dc_readl(DC_WIN_COLOR_DEPTH)))
+			continue;
+
+		size = dc_readl(DC_WIN_PRESCALED_SIZE);
+		mode->width = (size & 0x7fff) / mode->bpp;
+		mode->height = (size >> 16) & 0x1fff;
+		mode->stride = dc_readl(DC_WIN_LINE_STRIDE) & 0xffff;
+		mode->base = dc_readl(DC_WINBUF_START_ADDR);
+		mode->size = (u64)mode->stride * mode->height;
+		mode->source = 'A' + win;
+		found = true;
+	}
+	dc_writel(header, DC_CMD_DISPLAY_WINDOW_HEADER);
+
+	return found;
+}
+
+/* cboot's fb0_carveout note (surface entry), assumed to hold its 1080p screen */
+static bool cboot_framebuffer(const void *fdt, struct fb_mode *mode)
+{
+	const fdt32_t *reg;
+	int node, len;
+
+	node = fdt_path_offset(fdt, "/reserved-memory/fb0_carveout");
+	reg = node < 0 ? NULL : fdt_getprop(fdt, node, "reg", &len);
+	if (!reg || len < 4 * sizeof(u32))
+		return false;
+
+	mode->base = (u64)fdt32_to_cpu(reg[0]) << 32 | fdt32_to_cpu(reg[1]);
+	mode->size = (u64)fdt32_to_cpu(reg[2]) << 32 | fdt32_to_cpu(reg[3]);
+	mode->width = 1920;
+	mode->height = 1080;
+	mode->stride = 1920 * 4;
+	set_format(mode, "a8b8g8r8", 4);
+	mode->source = 'c';
+
+	return mode->base != 0;
+}
+
+/* A buffer U-Boot can safely draw into: all of it inside DRAM */
+static bool fb_usable(const struct fb_mode *mode)
+{
+	u64 used = (u64)mode->stride * mode->height;
+
+	return mode->base >= DRAM_START && mode->base % 64 == 0 &&
+	       mode->width >= 320 && mode->width <= 4096 &&
+	       mode->height >= 200 && mode->height <= 2304 &&
+	       mode->stride >= mode->width * mode->bpp &&
+	       used <= mode->size && used <= SZ_64M &&
+	       mode->base + used <= DRAM_END;
+}
+
+/*
+ * Point U-Boot's disabled simple-framebuffer at a usable buffer and enable
+ * it. Every property keeps its length, so the blob needs no extra room.
+ * U-Boot's simplefb has no stride, so it draws at stride / bpp pixels per
+ * line; the padding columns are simply off screen.
+ */
+static bool use_framebuffer(void *blob, const struct fb_mode *mode)
+{
+	fdt32_t reg[4];
+	int node, len;
+
+	node = fdt_path_offset(blob, "/framebuffer");
+	if (node < 0 || !fdt_getprop(blob, node, "format", &len) ||
+	    len != sizeof(mode->format))
+		return false;
+
+	reg[0] = cpu_to_fdt32(mode->base >> 32);
+	reg[1] = cpu_to_fdt32(mode->base);
+	reg[2] = cpu_to_fdt32(0);
+	reg[3] = cpu_to_fdt32(mode->stride * mode->height);
+
+	return !fdt_setprop_inplace(blob, node, "reg", reg, sizeof(reg)) &&
+	       !fdt_setprop_inplace_u32(blob, node, "width",
+					mode->stride / mode->bpp) &&
+	       !fdt_setprop_inplace_u32(blob, node, "height", mode->height) &&
+	       !fdt_setprop_inplace_u32(blob, node, "stride", mode->stride) &&
+	       !fdt_setprop_inplace(blob, node, "format", mode->format,
+				    sizeof(mode->format)) &&
+	       !fdt_nop_property(blob, node, "status");
+}
+
+/* Before video probes; returning an error here would hang */
+int board_fix_fdt(void *blob)
+{
+	const void *fdt = cboot_fdt();
+
+	if (dc_framebuffer(&dc_fb) && fb_usable(&dc_fb) &&
+	    use_framebuffer(blob, &dc_fb))
+		fb_source = dc_fb.source;
+	else if (fdt && cboot_framebuffer(fdt, &cboot_fb) &&
+		 fb_usable(&cboot_fb) && use_framebuffer(blob, &cboot_fb))
+		fb_source = cboot_fb.source;
+
+	return 0;
+}
+
+static void report_framebuffer(const char *what, const struct fb_mode *mode)
+{
+	printf("  %-12s ", what);
+	if (!mode->source) {
+		printf("none\n");
+		return;
+	}
+
+	printf("0x%llx, %ux%u, stride %u, %s%s\n", mode->base, mode->width,
+	       mode->height, mode->stride, mode->format,
+	       mode == fb_in_use() ? ", in use" : "");
+	if (mode->source != 'c')
+		printf("               (display controller A, window %c)\n",
+		       mode->source);
+}
+
+/*
+ * The display hardware as cboot left it: its clocks (on/in reset), the PLLs
+ * and whether display controller A runs. darcy-init prints the same lines
+ * under Linux, to compare.
+ */
+static void report_display_hw(void)
+{
+	unsigned int i, bank, bit;
+
+	printf("  clocks:      ");
+	for (i = 0; i < ARRAY_SIZE(display_clocks); i++) {
+		bank = display_clocks[i].id / 32;
+		bit = display_clocks[i].id % 32;
+		printf("%s %u/%u ", display_clocks[i].name,
+		       readl(CAR_BASE + car_enb[bank]) >> bit & 1,
+		       readl(CAR_BASE + car_rst[bank]) >> bit & 1);
+	}
+	printf("(clock on/in reset)\n");
+	printf("  PLLs:        D %08x D2 %08x (misc0 %08x) DP %08x, DISP1 src %08x, SOR1 src %08x\n",
+	       readl(CAR_BASE + CAR_PLLD_BASE), readl(CAR_BASE + CAR_PLLD2_BASE),
+	       readl(CAR_BASE + CAR_PLLD2_MISC0),
+	       readl(CAR_BASE + CAR_PLLDP_BASE),
+	       readl(CAR_BASE + CAR_CLK_SOURCE_DISP1),
+	       readl(CAR_BASE + CAR_CLK_SOURCE_SOR1));
+	printf("  PMC, pins:   powergates %08x, HDMI HPD pin %08x, CEC pin %08x\n",
+	       tegra_pmc_readl(PMC_PWRGATE_STATUS), readl(PINMUX_HDMI_HPD),
+	       readl(PINMUX_HDMI_CEC));
+	if (readl(CAR_CLK_OUT_ENB_L) & CAR_L_DISP1 &&
+	    !(readl(CAR_RST_DEVICES_L) & CAR_L_DISP1))
+		printf("  DC A:        command %08x power %08x state %08x clock %08x\n",
+		       dc_readl(DC_CMD_DISPLAY_COMMAND),
+		       dc_readl(DC_CMD_DISPLAY_POWER_CONTROL),
+		       dc_readl(DC_CMD_STATE_CONTROL),
+		       dc_readl(DC_DISP_DISP_CLOCK_CONTROL));
+}
+
+static void report_memory(const void *fdt)
+{
+	const fdt32_t *reg;
+	int node, len, banks;
+
+	node = fdt_path_offset(fdt, "/memory");
+	reg = node < 0 ? NULL : fdt_getprop(fdt, node, "reg", &len);
+	if (!reg) {
+		printf("  memory:      no /memory node\n");
+		return;
+	}
+
+	/* cboot's root node uses two address and two size cells */
+	banks = len / (4 * sizeof(u32));
+	printf("  memory:      %d bank(s) from cboot", banks);
+	if (banks > CONFIG_NR_DRAM_BANKS)
+		printf(", but U-Boot only keeps %d!", CONFIG_NR_DRAM_BANKS);
+	printf("\n");
+
+	for (; banks > 0; banks--, reg += 4)
+		printf("               0x%llx + 0x%llx\n",
+		       (u64)fdt32_to_cpu(reg[0]) << 32 | fdt32_to_cpu(reg[1]),
+		       (u64)fdt32_to_cpu(reg[2]) << 32 | fdt32_to_cpu(reg[3]));
+}
+
+static bool in_dram(u64 start, u64 size)
+{
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++) {
+		u64 bank = gd->bd->bi_dram[i].start;
+		u64 bank_size = gd->bd->bi_dram[i].size;
+
+		if (bank_size && start >= bank && start - bank < bank_size &&
+		    size <= bank_size - (start - bank))
+			return true;
+	}
+
+	return false;
+}
+
+/* Returns the FIT image to boot, if the ramdisk holds one */
+static const void *report_ramdisk(const void *fdt)
+{
+	const void *buf;
+	u64 start, end, size;
+
+	if (fdt_read_u64(fdt, "/chosen", "linux,initrd-start", &start) ||
+	    fdt_read_u64(fdt, "/chosen", "linux,initrd-end", &end) ||
+	    end <= start) {
+		printf("  ramdisk:     none\n");
+		return NULL;
+	}
+
+	size = end - start;
+	printf("  ramdisk:     0x%llx, %llu bytes", start, size);
+	if (!in_dram(start, size)) {
+		printf(", not inside RAM: ignored\n");
+		return NULL;
+	}
+
+	buf = (const void *)(uintptr_t)start;
+	printf(", crc32 %08x\n", crc32(0, buf, size));
+
+	if (start % 8 || fdt_check_header(buf) || fdt_totalsize(buf) > size) {
+		printf("               not a FIT image, so not booting it\n");
+		return NULL;
+	}
+
+	env_set_hex("cboot_fit_start", start);
+	return buf;
+}
+
+/* The device tree in the FIT, which describes the kernel next to it */
+static const void *fit_fdt(const void *fit)
+{
+	const void *fdt;
+	size_t size;
+	int node;
+
+	node = fit_conf_get_node(fit, NULL);
+	if (node >= 0)
+		node = fit_conf_get_prop_node(fit, node, FIT_FDT_PROP,
+					      IH_PHASE_NONE);
+	if (node < 0 || fit_image_get_data(fit, node, &fdt, &size) ||
+	    fdt_check_header(fdt))
+		return NULL;
+
+	return fdt;
+}
+
+/*
+ * ramoops, found the way Linux lays it out (fs/pstore/ram.c): whole dump
+ * records first, then the console. The sizes come from the device tree in
+ * the FIT, so they match the kernel that wrote them.
+ */
+static bool ramoops_layout(const void *fdt, struct ramoops *r)
+{
+	const fdt32_t *reg;
+	u64 base, size, record, console, other, dump;
+	int node, len;
+
+	node = fdt_node_offset_by_compatible(fdt, -1, "ramoops");
+	reg = node < 0 ? NULL : fdt_getprop(fdt, node, "reg", &len);
+	if (!reg || len != 4 * sizeof(u32) ||
+	    fdt_getprop(fdt, node, "ecc-size", NULL))
+		return false;
+
+	base = (u64)fdt32_to_cpu(reg[0]) << 32 | fdt32_to_cpu(reg[1]);
+	size = (u64)fdt32_to_cpu(reg[2]) << 32 | fdt32_to_cpu(reg[3]);
+	record = fdtdec_get_uint(fdt, node, "record-size", 0);
+	console = fdtdec_get_uint(fdt, node, "console-size", 0);
+	other = (u64)fdtdec_get_uint(fdt, node, "pmsg-size", 0) +
+		fdtdec_get_uint(fdt, node, "ftrace-size", 0);
+	if (console <= sizeof(struct ramoops_zone) || console + other > size ||
+	    !in_dram(base, size))
+		return false;
+
+	dump = size - console - other;
+	r->dumps = base;
+	r->records = record ? dump / record : 0;
+	r->record_size = r->records ? ALIGN_DOWN(dump / r->records, 2) : 0;
+	r->console = (struct ramoops_zone *)(uintptr_t)
+		     (base + r->records * r->record_size);
+	r->console_size = console - sizeof(struct ramoops_zone);
+	return true;
+}
+
+static struct ramoops_zone *ramoops_dump(const struct ramoops *r, u64 i)
+{
+	return (struct ramoops_zone *)(uintptr_t)(r->dumps + i * r->record_size);
+}
+
+/* Whether the kernel left a dump record, as it does when it panics */
+static bool dump_recorded(const struct ramoops *r)
+{
+	const struct ramoops_zone *zone;
+	u64 i;
+
+	for (i = 0; i < r->records; i++) {
+		zone = ramoops_dump(r, i);
+		if (zone->sig == RAMOOPS_SIG && zone->size &&
+		    zone->size <= r->record_size - sizeof(*zone))
+			return true;
+	}
+	return false;
+}
+
+/* Whether cboot started us after the watchdog reset the board */
+static bool watchdog_reset(void)
+{
+	static const char reason[] = "androidboot.bootreason=watchdog";
+	const char *p = env_get("cbootargs");
+
+	while (p && (p = strstr(p, reason))) {
+		p += sizeof(reason) - 1;
+		if (!*p || *p == ' ')
+			return true;
+	}
+	return false;
+}
+
+static void zap(struct ramoops_zone *zone)
+{
+	zone->start = 0;
+	zone->size = 0;
+	flush_dcache_range((ulong)zone, (ulong)zone + 64);
+}
+
+static char log_char(const struct ramoops_zone *zone, u32 i)
+{
+	return zone->data[(zone->start + i) % zone->size];
+}
+
+/*
+ * After a reset from a kernel U-Boot started, shows the end of that kernel's
+ * log, then empties the console and the dump records, so that it is shown
+ * once. Returns whether it did.
+ */
+static bool report_last_log(const struct ramoops *r)
+{
+	static const char tag[] = LOG_TAG;
+	struct ramoops_zone *zone = r->console;
+	u32 i, j, from, lines = 0;
+	bool tagged = false;
+	char c;
+
+	if (zone->sig != RAMOOPS_SIG || !zone->size ||
+	    zone->size > r->console_size || zone->start > zone->size)
+		return false;
+
+	for (i = 0; !tagged && i + sizeof(tag) - 1 <= zone->size; i++) {
+		for (j = 0; tag[j] && log_char(zone, i + j) == tag[j]; j++)
+			;
+		tagged = !tag[j];
+	}
+	if (!tagged)
+		return false;
+
+	for (from = zone->size; from > 0; from--)
+		if (log_char(zone, from - 1) == '\n' && ++lines > LOG_LINES)
+			break;
+
+	printf("\nThe end of the last kernel's log, from before the reset:\n");
+	for (i = from; i < zone->size; i++) {
+		c = log_char(zone, i);
+		putc(c == '\n' || (c >= ' ' && c <= '~') ? c : '?');
+	}
+	printf("\n--- End of the log.\n");
+
+	zap(zone);
+	for (i = 0; i < r->records; i++)
+		if (ramoops_dump(r, i)->sig == RAMOOPS_SIG)
+			zap(ramoops_dump(r, i));
+	return true;
+}
+
+/*
+ * Reset, into the bootloader menu (fastboot) or else Android. Any
+ * "recovery" reason board_quiesce_devices() left is cleared first. The PMC
+ * is secure-only on the SHIELD; tegra_pmc_*() go through the secure monitor
+ * when needed, and the reset keeps PMC_SCRATCH0.
+ */
+static void reboot_to(bool bootloader)
+{
+	u32 value = tegra_pmc_readl(PMC_SCRATCH0);
+
+	value &= ~(PMC_SCRATCH0_MODE_RECOVERY | PMC_SCRATCH0_MODE_BOOTLOADER);
+	if (bootloader)
+		value |= PMC_SCRATCH0_MODE_BOOTLOADER;
+	tegra_pmc_writel(value, PMC_SCRATCH0);
+	mdelay(500);
+	sysreset_walk_halt(SYSRESET_WARM);
+}
+
+static void signal_by_reboot(bool bootloader)
+{
+	printf("No console and nothing to boot: rebooting into %s\n",
+	       bootloader ? "the bootloader menu" : "Android");
+	reboot_to(bootloader);
+}
+
+/*
+ * Called by bootm just before the kernel starts. The watchdog makes sure a
+ * hung kernel resets (darcy_watchdog=0 leaves it off); the installed
+ * system's systemd takes it over through tegra_wdt. A test payload's resets
+ * are pointed at the recovery slot, where report_last_log() shows its log;
+ * the installed system's are left to Linux, so that a reboot boots it again.
+ */
+void board_quiesce_devices(void)
+{
+	ulong secs = env_get_ulong("darcy_watchdog", 10, 0);
+
+	if (!system_payload)
+		tegra_pmc_writel(tegra_pmc_readl(PMC_SCRATCH0) |
+				 PMC_SCRATCH0_MODE_RECOVERY, PMC_SCRATCH0);
+	if (!secs)
+		return;
+
+	secs = min(secs, 255UL);
+	printf("Watchdog armed: the board resets in %lu s\n", secs);
+	writel(1000000 / 4 | TMR_EN | TMR_PERIODIC, TMR5_PTV);
+	writel(WDT_CFG_TIMER5 | secs << WDT_CFG_PERIOD_SHIFT |
+	       WDT_CFG_PMC2CAR_RST_EN, WDT0_CFG);
+	writel(WDT_CMD_START_COUNTER, WDT0_CMD);
+}
+
+void nvidia_board_late_init(void)
+{
+	const void *fdt = cboot_fdt();
+	const void *fit = NULL, *payload;
+	const char *dts, *args;
+	struct ramoops oops;
+	ulong secs;
+
+	printf("\nSHIELD TV 2017 (P2894): U-Boot relocated to 0x%lx\n",
+	       gd->relocaddr);
+	report_framebuffer("display:", &dc_fb);
+
+	if (fdt) {
+		printf("cboot handoff, device tree at %p:\n", fdt);
+
+		dts = fdt_getprop(fdt, 0, "nvidia,dtsfilename", NULL);
+		printf("  board:       %s\n", dts ? dts : "unknown");
+
+		args = env_get("cbootargs");
+		printf("  bootargs:    %s\n", args ? args : "");
+
+		report_memory(fdt);
+		report_framebuffer("fb0_carveout:", &cboot_fb);
+		fit = report_ramdisk(fdt);
+	} else {
+		printf("cboot handed over no device tree\n");
+	}
+	report_display_hw();
+
+	payload = fit ? fit_fdt(fit) : NULL;
+	system_payload = payload &&
+			 fdt_getprop(payload, fdt_path_offset(payload, "/chosen"),
+				     "darcy,system", NULL);
+
+	/*
+	 * Back from a kernel U-Boot started: show its log instead of booting
+	 * it again, then go to fastboot, ready for the next image. The
+	 * installed system boots again, unless it panicked or hung.
+	 */
+	if (payload && ramoops_layout(payload, &oops) &&
+	    (!system_payload || dump_recorded(&oops) || watchdog_reset()) &&
+	    report_last_log(&oops)) {
+		secs = env_get_ulong("darcy_log_secs", 10, 60);
+		printf("Rebooting into the bootloader menu (fastboot) in %lu s\n",
+		       secs);
+		mdelay(secs * 1000);
+		reboot_to(true);
+	}
+
+	if (fit || (fb_in_use() && video_is_active()))
+		return;
+
+	signal_by_reboot(!dc_fb.source && !cboot_fb.source);
+}
+
+/* Tag the kernel command line, so report_last_log() knows the log again */
+static int tag_bootargs(void *blob)
+{
+	const char *args;
+	char *tagged;
+	int node, err;
+
+	node = fdt_find_or_add_subnode(blob, 0, "chosen");
+	if (node < 0)
+		return node;
+
+	args = fdt_getprop(blob, node, "bootargs", NULL);
+	tagged = malloc((args ? strlen(args) + 1 : 0) + sizeof(LOG_TAG));
+	if (!tagged)
+		return -FDT_ERR_NOSPACE;
+
+	sprintf(tagged, "%s%s" LOG_TAG, args ? args : "", args ? " " : "");
+	err = fdt_setprop_string(blob, node, "bootargs", tagged);
+	free(tagged);
+
+	return err;
+}
+
+/*
+ * Tag the kernel command line, and hand the console framebuffer on to the
+ * kernel, reserved
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	static const char compat[] = "simple-framebuffer";
+	const struct fb_mode *fb = fb_in_use();
+	struct fdt_memory mem;
+	int node;
+
+	if (tag_bootargs(blob))
+		printf("warning: could not tag the kernel command line\n");
+
+	if (!fb || !video_is_active())
+		return 0;
+
+	/*
+	 * The buffer lies inside the RAM cboot reports, so it is reserved as
+	 * no-map, in whole pages. A /memreserve/ would leave it in the
+	 * kernel's linear map, where arm64 refuses to ioremap it and
+	 * simpledrm gives up.
+	 */
+	mem.start = ALIGN_DOWN(fb->base, SZ_4K);
+	mem.end = ALIGN(fb->base + (u64)fb->stride * fb->height, SZ_4K) - 1;
+
+	node = fdt_add_subnode(blob, 0, "framebuffer");
+	if (node < 0 ||
+	    fdt_setprop(blob, node, "compatible", compat, sizeof(compat)) ||
+	    fdt_setup_simplefb_node(blob, node, fb->base, fb->width,
+				    fb->height, fb->stride, fb->format) ||
+	    fdtdec_add_reserved_memory(blob, "framebuffer", &mem, NULL, 0, NULL,
+				       FDTDEC_RESERVED_MEMORY_NO_MAP))
+		printf("warning: could not hand the framebuffer to the kernel\n");
+
+	return 0;
+}
diff --git a/board/nvidia/p2894/p2894.env b/board/nvidia/p2894/p2894.env
new file mode 100644
index 00000000..1b453e11
--- /dev/null
+++ b/board/nvidia/p2894/p2894.env
@@ -0,0 +1,27 @@
+/*
+ * NVIDIA SHIELD TV 2017 (darcy). cboot loads the Android boot image's
+ * ramdisk; when it holds a FIT image (kernel, device tree, initramfs),
+ * p2894.c exports its address. The kernel command line comes from the
+ * device tree inside the FIT. CONFIG_BOOTCOMMAND runs darcy_boot.
+ *
+ * Tegra's default fdt_high=~0 would make bootm edit the device tree in
+ * place inside the FIT and grow it over the next image, so it is cleared
+ * to make bootm copy the device tree out first.
+ */
+/*
+ * Seconds a kernel gets before the watchdog resets the board, and U-Boot
+ * shows the end of its log (p2894.c). The installed system's systemd takes
+ * the watchdog over (tegra_wdt). 0 leaves the watchdog off.
+ */
+darcy_watchdog=150
+
+/* Seconds U-Boot shows a kernel's log before it reboots into fastboot */
+darcy_log_secs=60
+
+darcy_boot=
+	if test -n "${cboot_fit_start}"; then
+		setenv fdt_high;
+		echo "Booting the FIT image at ${cboot_fit_start}";
+		bootm ${cboot_fit_start};
+	fi;
+	echo "Nothing to boot.";
