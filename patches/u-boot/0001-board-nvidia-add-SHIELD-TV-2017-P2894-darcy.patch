diff --git a/board/nvidia/p2894/p2894.c b/board/nvidia/p2894/p2894.c
new file mode 100644
index 00000000..93ddf2fb
--- /dev/null
+++ b/board/nvidia/p2894/p2894.c
@@ -0,0 +1,291 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * NVIDIA SHIELD TV 2017 ("darcy", board P2894)
+ *
+ * NVIDIA's cboot starts U-Boot as the kernel of an Android boot image and
+ * leaves the board set up. This reads what cboot hands over in its device
+ * tree (x0) and reports it on screen, since retail units have no reachable
+ * UART:
+ *
+ *  - the framebuffer cboot keeps running on HDMI. U-Boot's console uses it
+ *    only if cboot reports one big enough for 1080p; there is no fallback
+ *    address, because video probe clears the whole surface.
+ *  - the boot image's ramdisk. It is booted only if it lies in RAM and holds
+ *    a whole FIT image. Its CRC32 is always shown, so a test image can check
+ *    that nothing in U-Boot overwrote it.
+ *  - the board revision and memory map cboot detected.
+ *
+ * With no console on the TV and no FIT to boot, the report would go
+ * nowhere, so the next boot carries the answer instead: back into the
+ * bootloader menu when cboot reported no framebuffer, into Android when it
+ * reported one U-Boot could not use.
+ */
+
+#include <env.h>
+#include <fdt_support.h>
+#include <init.h>
+#include <stdio.h>
+#include <sysreset.h>
+#include <video.h>
+#include <asm/global_data.h>
+#include <asm/arch-tegra/cboot.h>
+#include <asm/arch-tegra/pmc.h>
+#include <linux/delay.h>
+#include <linux/libfdt.h>
+#include <linux/sizes.h>
+#include <u-boot/crc.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define FB_WIDTH	1920
+#define FB_HEIGHT	1080
+#define FB_STRIDE	(FB_WIDTH * 4)
+#define FB_SIZE		(FB_STRIDE * FB_HEIGHT)
+#define FB_FORMAT	"a8b8g8r8"
+
+/* 3 GiB of LPDDR4 */
+#define DRAM_START	0x80000000ULL
+#define DRAM_END	0x140000000ULL
+
+/* Android's reboot reason in PMC_SCRATCH0, which cboot acts on */
+#define PMC_SCRATCH0_MODE_BOOTLOADER	BIT(30)
+
+/* Written before relocation, when .bss is not usable yet */
+static u64 fb_base __section(".data");
+static u64 fb_size __section(".data");
+static bool fb_used __section(".data");
+
+static const void *cboot_fdt(void)
+{
+	const void *fdt = (const void *)cboot_boot_x0;
+
+	if (!fdt || fdt_check_header(fdt))
+		return NULL;
+
+	return fdt;
+}
+
+/* cboot writes some integers as one cell and some as two */
+static int fdt_read_u64(const void *fdt, const char *path, const char *name,
+			u64 *val)
+{
+	const fdt32_t *cell;
+	int node, len;
+
+	node = fdt_path_offset(fdt, path);
+	if (node < 0)
+		return node;
+
+	cell = fdt_getprop(fdt, node, name, &len);
+	if (!cell)
+		return len;
+
+	if (len == sizeof(u32))
+		*val = fdt32_to_cpu(cell[0]);
+	else if (len == sizeof(u64))
+		*val = (u64)fdt32_to_cpu(cell[0]) << 32 | fdt32_to_cpu(cell[1]);
+	else
+		return -FDT_ERR_BADVALUE;
+
+	return 0;
+}
+
+/* The surface entry of fb0_carveout, which cboot fills in at boot */
+static int cboot_framebuffer(const void *fdt, u64 *base, u64 *size)
+{
+	const fdt32_t *reg;
+	int node, len;
+
+	node = fdt_path_offset(fdt, "/reserved-memory/fb0_carveout");
+	if (node < 0)
+		return node;
+
+	reg = fdt_getprop(fdt, node, "reg", &len);
+	if (!reg || len < 4 * sizeof(u32))
+		return -FDT_ERR_BADVALUE;
+
+	*base = (u64)fdt32_to_cpu(reg[0]) << 32 | fdt32_to_cpu(reg[1]);
+	*size = (u64)fdt32_to_cpu(reg[2]) << 32 | fdt32_to_cpu(reg[3]);
+
+	return *base ? 0 : -FDT_ERR_NOTFOUND;
+}
+
+/*
+ * Enable U-Boot's disabled simple-framebuffer on cboot's surface, before
+ * video probes. Any doubt leaves it disabled; returning an error would hang.
+ */
+int board_fix_fdt(void *blob)
+{
+	const void *fdt = cboot_fdt();
+	fdt32_t reg[4];
+	int node;
+
+	if (!fdt || cboot_framebuffer(fdt, &fb_base, &fb_size))
+		return 0;
+
+	if (fb_base % SZ_4K || fb_size < FB_SIZE ||
+	    fb_base < DRAM_START || fb_base + FB_SIZE > DRAM_END)
+		return 0;
+
+	node = fdt_path_offset(blob, "/framebuffer");
+	if (node < 0)
+		return 0;
+
+	reg[0] = cpu_to_fdt32(fb_base >> 32);
+	reg[1] = cpu_to_fdt32(fb_base);
+	reg[2] = cpu_to_fdt32(0);
+	reg[3] = cpu_to_fdt32(FB_SIZE);
+	if (fdt_setprop_inplace(blob, node, "reg", reg, sizeof(reg)))
+		return 0;
+
+	/* Dropping "disabled" in place needs no room in the blob */
+	if (!fdt_nop_property(blob, node, "status"))
+		fb_used = true;
+
+	return 0;
+}
+
+static void report_memory(const void *fdt)
+{
+	const fdt32_t *reg;
+	int node, len, banks;
+
+	node = fdt_path_offset(fdt, "/memory");
+	reg = node < 0 ? NULL : fdt_getprop(fdt, node, "reg", &len);
+	if (!reg) {
+		printf("  memory:      no /memory node\n");
+		return;
+	}
+
+	/* cboot's root node uses two address and two size cells */
+	banks = len / (4 * sizeof(u32));
+	printf("  memory:      %d bank(s) from cboot", banks);
+	if (banks > CONFIG_NR_DRAM_BANKS)
+		printf(", but U-Boot only keeps %d!", CONFIG_NR_DRAM_BANKS);
+	printf("\n");
+
+	for (; banks > 0; banks--, reg += 4)
+		printf("               0x%llx + 0x%llx\n",
+		       (u64)fdt32_to_cpu(reg[0]) << 32 | fdt32_to_cpu(reg[1]),
+		       (u64)fdt32_to_cpu(reg[2]) << 32 | fdt32_to_cpu(reg[3]));
+}
+
+static bool in_dram(u64 start, u64 size)
+{
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++) {
+		u64 bank = gd->bd->bi_dram[i].start;
+		u64 bank_size = gd->bd->bi_dram[i].size;
+
+		if (bank_size && start >= bank && start - bank < bank_size &&
+		    size <= bank_size - (start - bank))
+			return true;
+	}
+
+	return false;
+}
+
+/* Returns whether the ramdisk holds a FIT image to boot */
+static bool report_ramdisk(const void *fdt)
+{
+	const void *buf;
+	u64 start, end, size;
+
+	if (fdt_read_u64(fdt, "/chosen", "linux,initrd-start", &start) ||
+	    fdt_read_u64(fdt, "/chosen", "linux,initrd-end", &end) ||
+	    end <= start) {
+		printf("  ramdisk:     none\n");
+		return false;
+	}
+
+	size = end - start;
+	printf("  ramdisk:     0x%llx, %llu bytes", start, size);
+	if (!in_dram(start, size)) {
+		printf(", not inside RAM: ignored\n");
+		return false;
+	}
+
+	buf = (const void *)(uintptr_t)start;
+	printf(", crc32 %08x\n", crc32(0, buf, size));
+
+	if (start % 8 || fdt_check_header(buf) || fdt_totalsize(buf) > size) {
+		printf("               not a FIT image, so not booting it\n");
+		return false;
+	}
+
+	env_set_hex("cboot_fit_start", start);
+	return true;
+}
+
+/*
+ * Reset, into the bootloader menu if asked. The PMC is secure-only on the
+ * SHIELD; tegra_pmc_*() go through the secure monitor when needed, and the
+ * reset keeps PMC_SCRATCH0.
+ */
+static void signal_by_reboot(bool bootloader)
+{
+	printf("No console and nothing to boot: rebooting into %s\n",
+	       bootloader ? "the bootloader menu" : "Android");
+	if (bootloader)
+		tegra_pmc_writel(tegra_pmc_readl(PMC_SCRATCH0) |
+				 PMC_SCRATCH0_MODE_BOOTLOADER, PMC_SCRATCH0);
+	mdelay(500);
+	sysreset_walk_halt(SYSRESET_WARM);
+}
+
+void nvidia_board_late_init(void)
+{
+	const void *fdt = cboot_fdt();
+	const char *dts, *args;
+
+	printf("\nSHIELD TV 2017 (P2894): U-Boot relocated to 0x%lx\n",
+	       gd->relocaddr);
+
+	if (!fdt) {
+		printf("cboot handed over no device tree\n");
+		signal_by_reboot(true);
+		return;
+	}
+
+	printf("cboot handoff, device tree at %p:\n", fdt);
+
+	dts = fdt_getprop(fdt, 0, "nvidia,dtsfilename", NULL);
+	printf("  board:       %s\n", dts ? dts : "unknown");
+
+	args = env_get("cbootargs");
+	printf("  bootargs:    %s\n", args ? args : "");
+
+	report_memory(fdt);
+
+	if (!fb_base)
+		printf("  framebuffer: none reported, console on UART only\n");
+	else
+		printf("  framebuffer: 0x%llx, %llu bytes, %s\n", fb_base,
+		       fb_size, fb_used ? "in use" : "rejected");
+
+	if (report_ramdisk(fdt) || (fb_used && video_is_active()))
+		return;
+
+	signal_by_reboot(!fb_base);
+}
+
+/* Hand the console framebuffer on to the kernel and keep it reserved */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	static const char compat[] = "simple-framebuffer";
+	int node;
+
+	if (!fb_used || !video_is_active())
+		return 0;
+
+	node = fdt_add_subnode(blob, 0, "framebuffer");
+	if (node < 0 ||
+	    fdt_setprop(blob, node, "compatible", compat, sizeof(compat)) ||
+	    fdt_setup_simplefb_node(blob, node, fb_base, FB_WIDTH, FB_HEIGHT,
+				    FB_STRIDE, FB_FORMAT) ||
+	    fdt_add_mem_rsv(blob, fb_base, FB_SIZE))
+		printf("warning: could not hand the framebuffer to the kernel\n");
+
+	return 0;
+}
diff --git a/board/nvidia/p2894/p2894.env b/board/nvidia/p2894/p2894.env
new file mode 100644
index 00000000..d420a430
--- /dev/null
+++ b/board/nvidia/p2894/p2894.env
@@ -0,0 +1,17 @@
+/*
+ * NVIDIA SHIELD TV 2017 (darcy). cboot loads the Android boot image's
+ * ramdisk; when it holds a FIT image (kernel, device tree, initramfs),
+ * p2894.c exports its address. The kernel command line comes from the
+ * device tree inside the FIT. CONFIG_BOOTCOMMAND runs darcy_boot.
+ *
+ * Tegra's default fdt_high=~0 would make bootm edit the device tree in
+ * place inside the FIT and grow it over the next image, so it is cleared
+ * to make bootm copy the device tree out first.
+ */
+darcy_boot=
+	if test -n "${cboot_fit_start}"; then
+		setenv fdt_high;
+		echo "Booting the FIT image at ${cboot_fit_start}";
+		bootm ${cboot_fit_start};
+	fi;
+	echo "Nothing to boot.";
