From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: marcho78 <marcho78@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:40:00 -0700
Subject: [PATCH] drm/nouveau: Sync only BOs the CPU may have written

Where the GPU doesn't snoop the CPU's caches (Tegra's GK20A and GM20B),
nouveau_bo_validate() cleans the data cache over every page of every
non-coherent BO a pushbuf uses, on every pushbuf, so that the GPU sees
what the CPU wrote. Most of those BOs are textures and render targets
that only the GPU writes, and cleaning them is wasted work: in
SuperTuxKart 1.5's benchmark on a SHIELD TV (GM20B), 69% of the game's
CPU time went to dcache_clean_poc() under nouveau_bo_sync_for_device(),
and it ran at 3 frames per second.

Track what can leave dirty lines behind. A CPU mapping (a userspace
fault, a kernel kmap or vmap, a ptrace write) marks the BO for good:
writes through it can come at any time. New pages (populated, which
zeroes or swaps them in, or a move, which may copy them) mark it until
the next validation. Sync only marked BOs. CPU_FINI now takes the
reservation that protects the marks.
---
diff --git a/drivers/gpu/drm/nouveau/nouveau_bo.c b/drivers/gpu/drm/nouveau/nouveau_bo.c
index 6dcb92575..e7fbcc895 100644
--- a/drivers/gpu/drm/nouveau/nouveau_bo.c
+++ b/drivers/gpu/drm/nouveau/nouveau_bo.c
@@ -674,6 +674,7 @@ nouveau_bo_map(struct nouveau_bo *nvbo)
 	if (ret)
 		return ret;
 
+	nvbo->cpu_mapped = true;
 	ret = ttm_bo_kmap(&nvbo->bo, 0, PFN_UP(nvbo->bo.base.size), &nvbo->kmap);
 
 	ttm_bo_unreserve(&nvbo->bo);
@@ -707,6 +708,14 @@ nouveau_bo_sync_for_device(struct nouveau_bo *nvbo)
 	if (nvbo->force_coherent)
 		return;
 
+	/* Nor if the CPU can't have written to it since it was last synced:
+	 * nothing maps it, and its pages are the ones synced then. Textures
+	 * and render targets the GPU fills are like that, and cleaning all of
+	 * them on every pushbuf can take most of a frame.
+	 */
+	if (!nvbo->cpu_mapped && !nvbo->sync_pending)
+		return;
+
 	i = 0;
 	while (i < ttm_dma->num_pages) {
 		struct page *p = ttm_dma->pages[i];
@@ -793,6 +802,7 @@ nouveau_bo_validate(struct nouveau_bo *nvbo, bool interruptible,
 		return ret;
 
 	nouveau_bo_sync_for_device(nvbo);
+	nvbo->sync_pending = false;
 
 	return 0;
 }
@@ -1154,6 +1164,9 @@ nouveau_bo_move(struct ttm_buffer_object *bo, bool evict,
 	struct nouveau_drm_tile *new_tile = NULL;
 	int ret = 0;
 
+	/* The pages may be new, zeroed or copied by the CPU */
+	nvbo->sync_pending = true;
+
 	if (new_reg->mem_type == TTM_PL_TT) {
 		ret = nouveau_ttm_tt_bind(bo->bdev, bo->ttm, new_reg);
 		if (ret)
@@ -1423,6 +1436,7 @@ nouveau_ttm_tt_populate(struct ttm_device *bdev,
 	struct ttm_tt *ttm_dma = (void *)ttm;
 	struct nouveau_drm *drm;
 	bool slave = !!(ttm->page_flags & TTM_TT_FLAG_EXTERNAL);
+	int ret;
 
 	if (ttm_tt_is_populated(ttm))
 		return 0;
@@ -1435,7 +1449,11 @@ nouveau_ttm_tt_populate(struct ttm_device *bdev,
 
 	drm = nouveau_bdev(bdev);
 
-	return ttm_pool_alloc(&drm->ttm.bdev.pool, ttm, ctx);
+	ret = ttm_pool_alloc(&drm->ttm.bdev.pool, ttm, ctx);
+	/* AGP's TTs aren't nouveau_sgdma_be */
+	if (!ret && !drm->agp.bridge)
+		nouveau_sgdma_populated(ttm);
+	return ret;
 }
 
 static void
diff --git a/drivers/gpu/drm/nouveau/nouveau_bo.h b/drivers/gpu/drm/nouveau/nouveau_bo.h
index 6c26beeb4..dd8c4c7ac 100644
--- a/drivers/gpu/drm/nouveau/nouveau_bo.h
+++ b/drivers/gpu/drm/nouveau/nouveau_bo.h
@@ -26,6 +26,12 @@ struct nouveau_bo {
 	struct list_head entry;
 	int pbbo_index;
 	bool validate_mapped;
+	/* The CPU may write to it through a mapping at any time */
+	bool cpu_mapped;
+	/* The CPU filled its pages (allocated, moved, swapped in) since the
+	 * last validation
+	 */
+	bool sync_pending;
 
 	/* Root GEM object we derive the dma_resv of in case this BO is not
 	 * shared between VMs.
diff --git a/drivers/gpu/drm/nouveau/nouveau_gem.c b/drivers/gpu/drm/nouveau/nouveau_gem.c
index 1958bd52d..771fab379 100644
--- a/drivers/gpu/drm/nouveau/nouveau_gem.c
+++ b/drivers/gpu/drm/nouveau/nouveau_gem.c
@@ -50,6 +50,7 @@ static vm_fault_t nouveau_ttm_fault(struct vm_fault *vmf)
 	if (ret)
 		return ret;
 
+	nouveau_bo(bo)->cpu_mapped = true;
 	ret = nouveau_ttm_fault_reserve_notify(bo);
 	if (ret)
 		goto error_unlock;
@@ -66,11 +67,28 @@ static vm_fault_t nouveau_ttm_fault(struct vm_fault *vmf)
 	return ret;
 }
 
+static int nouveau_ttm_vm_access(struct vm_area_struct *vma, unsigned long addr,
+				 void *buf, int len, int write)
+{
+	struct ttm_buffer_object *bo = vma->vm_private_data;
+	int ret;
+
+	if (write) {
+		ret = ttm_bo_reserve(bo, true, false, NULL);
+		if (ret)
+			return ret;
+		nouveau_bo(bo)->cpu_mapped = true;
+		ttm_bo_unreserve(bo);
+	}
+
+	return ttm_bo_vm_access(vma, addr, buf, len, write);
+}
+
 static const struct vm_operations_struct nouveau_ttm_vm_ops = {
 	.fault = nouveau_ttm_fault,
 	.open = ttm_bo_vm_open,
 	.close = ttm_bo_vm_close,
-	.access = ttm_bo_vm_access
+	.access = nouveau_ttm_vm_access
 };
 
 void
@@ -214,6 +232,13 @@ nouveau_gem_object_close(struct drm_gem_object *gem, struct drm_file *file_priv)
 	ttm_bo_unreserve(&nvbo->bo);
 }
 
+static int
+nouveau_gem_object_vmap(struct drm_gem_object *gem, struct iosys_map *map)
+{
+	nouveau_gem_object(gem)->cpu_mapped = true;
+	return drm_gem_ttm_vmap(gem, map);
+}
+
 const struct drm_gem_object_funcs nouveau_gem_object_funcs = {
 	.free = nouveau_gem_object_del,
 	.open = nouveau_gem_object_open,
@@ -222,7 +247,7 @@ const struct drm_gem_object_funcs nouveau_gem_object_funcs = {
 	.pin = nouveau_gem_prime_pin,
 	.unpin = nouveau_gem_prime_unpin,
 	.get_sg_table = nouveau_gem_prime_get_sg_table,
-	.vmap = drm_gem_ttm_vmap,
+	.vmap = nouveau_gem_object_vmap,
 	.vunmap = drm_gem_ttm_vunmap,
 	.mmap = drm_gem_ttm_mmap,
 	.vm_ops = &nouveau_ttm_vm_ops,
@@ -712,6 +737,7 @@ nouveau_gem_pushbuf_reloc_apply(struct nouveau_cli *cli,
 				break;
 			}
 			nvbo->validate_mapped = true;
+			nvbo->cpu_mapped = true;
 		}
 
 		if (r->flags & NOUVEAU_GEM_RELOC_LOW)
@@ -918,6 +944,7 @@ nouveau_gem_ioctl_pushbuf(struct drm_device *dev, void *data,
 						goto out;
 					}
 					nvbo->validate_mapped = true;
+					nvbo->cpu_mapped = true;
 				}
 
 				nouveau_bo_wr32(nvbo, (push[i].offset +
@@ -1027,15 +1054,21 @@ nouveau_gem_ioctl_cpu_fini(struct drm_device *dev, void *data,
 	struct drm_nouveau_gem_cpu_fini *req = data;
 	struct drm_gem_object *gem;
 	struct nouveau_bo *nvbo;
+	int ret;
 
 	gem = drm_gem_object_lookup(file_priv, req->handle);
 	if (!gem)
 		return -ENOENT;
 	nvbo = nouveau_gem_object(gem);
 
-	nouveau_bo_sync_for_device(nvbo);
+	/* The sync reads fields the reservation protects */
+	ret = ttm_bo_reserve(&nvbo->bo, true, false, NULL);
+	if (!ret) {
+		nouveau_bo_sync_for_device(nvbo);
+		ttm_bo_unreserve(&nvbo->bo);
+	}
 	drm_gem_object_put(gem);
-	return 0;
+	return ret;
 }
 
 int
diff --git a/drivers/gpu/drm/nouveau/nouveau_sgdma.c b/drivers/gpu/drm/nouveau/nouveau_sgdma.c
index 2bd037619..0088bb04d 100644
--- a/drivers/gpu/drm/nouveau/nouveau_sgdma.c
+++ b/drivers/gpu/drm/nouveau/nouveau_sgdma.c
@@ -14,6 +14,8 @@ struct nouveau_sgdma_be {
 	 */
 	struct ttm_tt ttm;
 	struct nouveau_mem *mem;
+	/* Its BO, for nouveau_sgdma_populated() */
+	struct nouveau_bo *nvbo;
 };
 
 void
@@ -85,5 +87,15 @@ nouveau_sgdma_create_ttm(struct ttm_buffer_object *bo, uint32_t page_flags)
 		kfree(nvbe);
 		return NULL;
 	}
+	nvbe->nvbo = nvbo;
 	return &nvbe->ttm;
 }
+
+/* New pages, zeroed or swapped in by the CPU: sync them before the GPU's use */
+void
+nouveau_sgdma_populated(struct ttm_tt *ttm)
+{
+	struct nouveau_sgdma_be *nvbe = (struct nouveau_sgdma_be *)ttm;
+
+	nvbe->nvbo->sync_pending = true;
+}
diff --git a/drivers/gpu/drm/nouveau/nouveau_ttm.h b/drivers/gpu/drm/nouveau/nouveau_ttm.h
index 2f0efda7c..6b8bb8717 100644
--- a/drivers/gpu/drm/nouveau/nouveau_ttm.h
+++ b/drivers/gpu/drm/nouveau/nouveau_ttm.h
@@ -14,6 +14,7 @@ extern const struct ttm_resource_manager_func nv04_gart_manager;
 
 struct ttm_tt *nouveau_sgdma_create_ttm(struct ttm_buffer_object *bo,
 					u32 page_flags);
+void nouveau_sgdma_populated(struct ttm_tt *ttm);
 
 int  nouveau_ttm_init(struct nouveau_drm *drm);
 void nouveau_ttm_fini(struct nouveau_drm *drm);
