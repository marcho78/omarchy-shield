From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: marcho78 <marcho78@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:40:00 -0700
Subject: [PATCH] drm/nouveau: Sync only what the CPU may have written

Where the GPU doesn't snoop the CPU's caches (Tegra's GK20A and GM20B),
nouveau_bo_validate() cleans the data cache over every page of every
non-coherent BO a pushbuf uses, on every pushbuf, so that the GPU sees
what the CPU wrote. Most of those pages the CPU hasn't touched since the
last clean, or ever: textures and render targets only the GPU writes,
vertex buffers the CPU filled once. In SuperTuxKart 1.5's benchmark on a
SHIELD TV (GM20B), 69% of the game's CPU time went to dcache_clean_poc()
under nouveau_bo_sync_for_device(), and it ran at 3 frames per second.

Track what can leave dirty lines behind, and clean only that:
- a userspace mapping: a fault marks the pages it maps (the faulting one
  and TTM's prefault after it, or the whole BO for a ptrace write), and
  before the GPU's use the BO's mappings are revoked, then the marked
  pages cleaned. Writes before the revocation are in the caches the
  clean reaches; writes after fault the mappings in again, waiting for
  the reservation the validation holds, and mark the pages again.
- a kernel mapping (kmap, vmap), which lasts: the whole BO, every time.
- new pages (populated, which zeroes or swaps them in, or a move, which
  may copy them): the whole BO, once.
CPU_FINI takes the reservation that protects the marks.
---
diff --git a/drivers/gpu/drm/nouveau/nouveau_bo.c b/drivers/gpu/drm/nouveau/nouveau_bo.c
index 6dcb92575..0cd01457b 100644
--- a/drivers/gpu/drm/nouveau/nouveau_bo.c
+++ b/drivers/gpu/drm/nouveau/nouveau_bo.c
@@ -674,6 +674,7 @@ nouveau_bo_map(struct nouveau_bo *nvbo)
 	if (ret)
 		return ret;
 
+	nvbo->cpu_kmapped = true;
 	ret = ttm_bo_kmap(&nvbo->bo, 0, PFN_UP(nvbo->bo.base.size), &nvbo->kmap);
 
 	ttm_bo_unreserve(&nvbo->bo);
@@ -689,12 +690,14 @@ nouveau_bo_unmap(struct nouveau_bo *nvbo)
 	ttm_bo_kunmap(&nvbo->kmap);
 }
 
-void
-nouveau_bo_sync_for_device(struct nouveau_bo *nvbo)
+/* Clean the CPU's caches over pages first to last of the BO, for the GPU */
+static void
+nouveau_bo_sync_pages_for_device(struct nouveau_bo *nvbo, unsigned long first,
+				 unsigned long last)
 {
 	struct nouveau_drm *drm = nouveau_bdev(nvbo->bo.bdev);
 	struct ttm_tt *ttm_dma = (struct ttm_tt *)nvbo->bo.ttm;
-	int i, j;
+	unsigned long i, j;
 
 	if (!ttm_dma || !ttm_dma->dma_address)
 		return;
@@ -707,12 +710,16 @@ nouveau_bo_sync_for_device(struct nouveau_bo *nvbo)
 	if (nvbo->force_coherent)
 		return;
 
-	i = 0;
-	while (i < ttm_dma->num_pages) {
+	if (first >= ttm_dma->num_pages)
+		return;
+	last = min_t(unsigned long, last, ttm_dma->num_pages - 1);
+
+	i = first;
+	while (i <= last) {
 		struct page *p = ttm_dma->pages[i];
 		size_t num_pages = 1;
 
-		for (j = i + 1; j < ttm_dma->num_pages; ++j) {
+		for (j = i + 1; j <= last; ++j) {
 			if (++p != ttm_dma->pages[j])
 				break;
 
@@ -725,6 +732,45 @@ nouveau_bo_sync_for_device(struct nouveau_bo *nvbo)
 	}
 }
 
+void
+nouveau_bo_sync_for_device(struct nouveau_bo *nvbo)
+{
+	/* Not if the CPU can't have written to it since it was last synced
+	 * (nouveau_bo_sync_dirty()): no kernel mapping lasts, and its pages
+	 * are the ones synced then. Textures and render targets the GPU fills
+	 * are like that, and so are buffers the CPU filled once; cleaning all
+	 * of them on every pushbuf can take most of a frame.
+	 */
+	if (!nvbo->cpu_kmapped && !nvbo->sync_pending)
+		return;
+
+	nouveau_bo_sync_pages_for_device(nvbo, 0, ULONG_MAX);
+}
+
+/*
+ * Before the GPU uses it, with the BO reserved. If userspace may have
+ * written to it, revoke its mappings first: writes after this fault them in
+ * again (nouveau_ttm_fault()), which marks the pages again, and writes
+ * before it are in the caches the sync then cleans, over the pages the
+ * faults mapped.
+ */
+void
+nouveau_bo_sync_dirty(struct nouveau_bo *nvbo)
+{
+	if (nvbo->cpu_dirty) {
+		ttm_bo_unmap_virtual(&nvbo->bo);
+		nvbo->cpu_dirty = false;
+		/* Otherwise all of it is synced below */
+		if (!nvbo->cpu_kmapped && !nvbo->sync_pending)
+			nouveau_bo_sync_pages_for_device(nvbo,
+							 nvbo->dirty_first,
+							 nvbo->dirty_last);
+	}
+
+	nouveau_bo_sync_for_device(nvbo);
+	nvbo->sync_pending = false;
+}
+
 void
 nouveau_bo_sync_for_cpu(struct nouveau_bo *nvbo)
 {
@@ -792,7 +838,7 @@ nouveau_bo_validate(struct nouveau_bo *nvbo, bool interruptible,
 	if (ret)
 		return ret;
 
-	nouveau_bo_sync_for_device(nvbo);
+	nouveau_bo_sync_dirty(nvbo);
 
 	return 0;
 }
@@ -1154,6 +1200,9 @@ nouveau_bo_move(struct ttm_buffer_object *bo, bool evict,
 	struct nouveau_drm_tile *new_tile = NULL;
 	int ret = 0;
 
+	/* The pages may be new, zeroed or copied by the CPU */
+	nvbo->sync_pending = true;
+
 	if (new_reg->mem_type == TTM_PL_TT) {
 		ret = nouveau_ttm_tt_bind(bo->bdev, bo->ttm, new_reg);
 		if (ret)
@@ -1423,6 +1472,7 @@ nouveau_ttm_tt_populate(struct ttm_device *bdev,
 	struct ttm_tt *ttm_dma = (void *)ttm;
 	struct nouveau_drm *drm;
 	bool slave = !!(ttm->page_flags & TTM_TT_FLAG_EXTERNAL);
+	int ret;
 
 	if (ttm_tt_is_populated(ttm))
 		return 0;
@@ -1435,7 +1485,11 @@ nouveau_ttm_tt_populate(struct ttm_device *bdev,
 
 	drm = nouveau_bdev(bdev);
 
-	return ttm_pool_alloc(&drm->ttm.bdev.pool, ttm, ctx);
+	ret = ttm_pool_alloc(&drm->ttm.bdev.pool, ttm, ctx);
+	/* AGP's TTs aren't nouveau_sgdma_be */
+	if (!ret && !drm->agp.bridge)
+		nouveau_sgdma_populated(ttm);
+	return ret;
 }
 
 static void
diff --git a/drivers/gpu/drm/nouveau/nouveau_bo.h b/drivers/gpu/drm/nouveau/nouveau_bo.h
index 6c26beeb4..cdf97e81f 100644
--- a/drivers/gpu/drm/nouveau/nouveau_bo.h
+++ b/drivers/gpu/drm/nouveau/nouveau_bo.h
@@ -26,6 +26,20 @@ struct nouveau_bo {
 	struct list_head entry;
 	int pbbo_index;
 	bool validate_mapped;
+	/* A kernel mapping of it (kmap, vmap) lasts: the CPU may write
+	 * through it at any time
+	 */
+	bool cpu_kmapped;
+	/* Userspace faulted a mapping of it in since the last sync, and may
+	 * have written through it: to pages dirty_first to dirty_last
+	 */
+	bool cpu_dirty;
+	unsigned long dirty_first;
+	unsigned long dirty_last;
+	/* The CPU filled its pages (allocated, moved, swapped in) since the
+	 * last validation
+	 */
+	bool sync_pending;
 
 	/* Root GEM object we derive the dma_resv of in case this BO is not
 	 * shared between VMs.
@@ -86,6 +100,7 @@ void nouveau_bo_fence(struct nouveau_bo *, struct nouveau_fence *, bool exclusiv
 int  nouveau_bo_validate(struct nouveau_bo *, bool interruptible,
 			 bool no_wait_gpu);
 void nouveau_bo_sync_for_device(struct nouveau_bo *nvbo);
+void nouveau_bo_sync_dirty(struct nouveau_bo *nvbo);
 void nouveau_bo_sync_for_cpu(struct nouveau_bo *nvbo);
 void nouveau_bo_add_io_reserve_lru(struct ttm_buffer_object *bo);
 void nouveau_bo_del_io_reserve_lru(struct ttm_buffer_object *bo);
diff --git a/drivers/gpu/drm/nouveau/nouveau_gem.c b/drivers/gpu/drm/nouveau/nouveau_gem.c
index 1958bd52d..1ab15bb23 100644
--- a/drivers/gpu/drm/nouveau/nouveau_gem.c
+++ b/drivers/gpu/drm/nouveau/nouveau_gem.c
@@ -39,6 +39,25 @@
 #include <nvif/class.h>
 #include <nvif/push206e.h>
 
+/*
+ * Pages first to first + count - 1 of the BO may be written through a
+ * userspace mapping. Reserved.
+ */
+static void nouveau_bo_mark_dirty(struct nouveau_bo *nvbo, unsigned long first,
+				  unsigned long count)
+{
+	unsigned long last = first + count - 1;
+
+	if (!nvbo->cpu_dirty) {
+		nvbo->dirty_first = first;
+		nvbo->dirty_last = last;
+		nvbo->cpu_dirty = true;
+	} else {
+		nvbo->dirty_first = min(nvbo->dirty_first, first);
+		nvbo->dirty_last = max(nvbo->dirty_last, last);
+	}
+}
+
 static vm_fault_t nouveau_ttm_fault(struct vm_fault *vmf)
 {
 	struct vm_area_struct *vma = vmf->vma;
@@ -50,6 +69,10 @@ static vm_fault_t nouveau_ttm_fault(struct vm_fault *vmf)
 	if (ret)
 		return ret;
 
+	/* ttm_bo_vm_fault_reserved() maps this page and up to the next ones */
+	nouveau_bo_mark_dirty(nouveau_bo(bo),
+			      vmf->pgoff - drm_vma_node_start(&bo->base.vma_node),
+			      TTM_BO_VM_NUM_PREFAULT);
 	ret = nouveau_ttm_fault_reserve_notify(bo);
 	if (ret)
 		goto error_unlock;
@@ -66,11 +89,28 @@ static vm_fault_t nouveau_ttm_fault(struct vm_fault *vmf)
 	return ret;
 }
 
+static int nouveau_ttm_vm_access(struct vm_area_struct *vma, unsigned long addr,
+				 void *buf, int len, int write)
+{
+	struct ttm_buffer_object *bo = vma->vm_private_data;
+	int ret;
+
+	if (write) {
+		ret = ttm_bo_reserve(bo, true, false, NULL);
+		if (ret)
+			return ret;
+		nouveau_bo_mark_dirty(nouveau_bo(bo), 0, PFN_UP(bo->base.size));
+		ttm_bo_unreserve(bo);
+	}
+
+	return ttm_bo_vm_access(vma, addr, buf, len, write);
+}
+
 static const struct vm_operations_struct nouveau_ttm_vm_ops = {
 	.fault = nouveau_ttm_fault,
 	.open = ttm_bo_vm_open,
 	.close = ttm_bo_vm_close,
-	.access = ttm_bo_vm_access
+	.access = nouveau_ttm_vm_access
 };
 
 void
@@ -214,6 +254,13 @@ nouveau_gem_object_close(struct drm_gem_object *gem, struct drm_file *file_priv)
 	ttm_bo_unreserve(&nvbo->bo);
 }
 
+static int
+nouveau_gem_object_vmap(struct drm_gem_object *gem, struct iosys_map *map)
+{
+	nouveau_gem_object(gem)->cpu_kmapped = true;
+	return drm_gem_ttm_vmap(gem, map);
+}
+
 const struct drm_gem_object_funcs nouveau_gem_object_funcs = {
 	.free = nouveau_gem_object_del,
 	.open = nouveau_gem_object_open,
@@ -222,7 +269,7 @@ const struct drm_gem_object_funcs nouveau_gem_object_funcs = {
 	.pin = nouveau_gem_prime_pin,
 	.unpin = nouveau_gem_prime_unpin,
 	.get_sg_table = nouveau_gem_prime_get_sg_table,
-	.vmap = drm_gem_ttm_vmap,
+	.vmap = nouveau_gem_object_vmap,
 	.vunmap = drm_gem_ttm_vunmap,
 	.mmap = drm_gem_ttm_mmap,
 	.vm_ops = &nouveau_ttm_vm_ops,
@@ -712,6 +759,7 @@ nouveau_gem_pushbuf_reloc_apply(struct nouveau_cli *cli,
 				break;
 			}
 			nvbo->validate_mapped = true;
+			nvbo->cpu_kmapped = true;
 		}
 
 		if (r->flags & NOUVEAU_GEM_RELOC_LOW)
@@ -918,6 +966,7 @@ nouveau_gem_ioctl_pushbuf(struct drm_device *dev, void *data,
 						goto out;
 					}
 					nvbo->validate_mapped = true;
+					nvbo->cpu_kmapped = true;
 				}
 
 				nouveau_bo_wr32(nvbo, (push[i].offset +
@@ -1027,15 +1076,21 @@ nouveau_gem_ioctl_cpu_fini(struct drm_device *dev, void *data,
 	struct drm_nouveau_gem_cpu_fini *req = data;
 	struct drm_gem_object *gem;
 	struct nouveau_bo *nvbo;
+	int ret;
 
 	gem = drm_gem_object_lookup(file_priv, req->handle);
 	if (!gem)
 		return -ENOENT;
 	nvbo = nouveau_gem_object(gem);
 
-	nouveau_bo_sync_for_device(nvbo);
+	/* The sync uses fields the reservation protects */
+	ret = ttm_bo_reserve(&nvbo->bo, true, false, NULL);
+	if (!ret) {
+		nouveau_bo_sync_dirty(nvbo);
+		ttm_bo_unreserve(&nvbo->bo);
+	}
 	drm_gem_object_put(gem);
-	return 0;
+	return ret;
 }
 
 int
diff --git a/drivers/gpu/drm/nouveau/nouveau_sgdma.c b/drivers/gpu/drm/nouveau/nouveau_sgdma.c
index 2bd037619..0088bb04d 100644
--- a/drivers/gpu/drm/nouveau/nouveau_sgdma.c
+++ b/drivers/gpu/drm/nouveau/nouveau_sgdma.c
@@ -14,6 +14,8 @@ struct nouveau_sgdma_be {
 	 */
 	struct ttm_tt ttm;
 	struct nouveau_mem *mem;
+	/* Its BO, for nouveau_sgdma_populated() */
+	struct nouveau_bo *nvbo;
 };
 
 void
@@ -85,5 +87,15 @@ nouveau_sgdma_create_ttm(struct ttm_buffer_object *bo, uint32_t page_flags)
 		kfree(nvbe);
 		return NULL;
 	}
+	nvbe->nvbo = nvbo;
 	return &nvbe->ttm;
 }
+
+/* New pages, zeroed or swapped in by the CPU: sync them before the GPU's use */
+void
+nouveau_sgdma_populated(struct ttm_tt *ttm)
+{
+	struct nouveau_sgdma_be *nvbe = (struct nouveau_sgdma_be *)ttm;
+
+	nvbe->nvbo->sync_pending = true;
+}
diff --git a/drivers/gpu/drm/nouveau/nouveau_ttm.h b/drivers/gpu/drm/nouveau/nouveau_ttm.h
index 2f0efda7c..6b8bb8717 100644
--- a/drivers/gpu/drm/nouveau/nouveau_ttm.h
+++ b/drivers/gpu/drm/nouveau/nouveau_ttm.h
@@ -14,6 +14,7 @@ extern const struct ttm_resource_manager_func nv04_gart_manager;
 
 struct ttm_tt *nouveau_sgdma_create_ttm(struct ttm_buffer_object *bo,
 					u32 page_flags);
+void nouveau_sgdma_populated(struct ttm_tt *ttm);
 
 int  nouveau_ttm_init(struct nouveau_drm *drm);
 void nouveau_ttm_fini(struct nouveau_drm *drm);
